<div class="max-w-6xl mx-auto px-4 sm:px-6">
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Members</h1>
      <p class="text-sm text-gray-500 mt-1"><%= @total_member_count %> members in the community</p>
    </div>
    <% if authenticated? %>
      <%= link_to "My Profile", my_profile_path, class: "btn-primary text-white px-5 py-2.5 rounded-xl font-medium" %>
    <% end %>
  </div>

  <!-- Search and Filter -->
  <div class="card p-4 mb-8">
    <%= form_with url: profiles_path, method: :get, class: "flex flex-wrap gap-4 items-end" do |form| %>
      <div class="flex-1 min-w-[200px]">
        <label class="block text-sm font-medium text-gray-700 mb-1">Search</label>
        <%= form.text_field :q, value: params[:q], placeholder: "Search by name...", class: "w-full rounded-xl border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500" %>
      </div>
      <div class="flex-1 min-w-[200px]">
        <label class="block text-sm font-medium text-gray-700 mb-1">Skill</label>
        <%= form.text_field :skill, value: params[:skill], placeholder: "Filter by skill...", class: "w-full rounded-xl border-gray-300 shadow-sm focus:border-purple-500 focus:ring-purple-500" %>
      </div>
      <%= form.submit "Search", class: "btn-primary text-white px-5 py-2.5 rounded-xl font-medium cursor-pointer" %>
      <% if params[:q].present? || params[:skill].present? %>
        <%= link_to "Clear", profiles_path, class: "text-gray-500 hover:text-gray-700 py-2" %>
      <% end %>
    <% end %>
  </div>

  <% if @profiles.empty? %>
    <div class="card p-12 text-center">
      <p class="text-gray-500 text-lg">No members found.</p>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @profiles.each do |profile| %>
        <div class="card p-6">
          <div class="flex items-start gap-4">
            <% if profile.avatar.attached? %>
              <%= image_tag profile.avatar, class: "w-14 h-14 rounded-full object-cover ring-2 ring-purple-100" %>
            <% else %>
              <div class="w-14 h-14 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white text-xl font-bold">
                <%= profile.name.first.upcase %>
              </div>
            <% end %>
            <div class="flex-1 min-w-0">
              <h2 class="text-lg font-semibold text-gray-900 truncate">
                <%= link_to profile.name, profile, class: "hover:text-purple-600 transition-colors" %>
              </h2>
              <% if profile.location.present? %>
                <p class="text-sm text-gray-500"><%= profile.location %></p>
              <% end %>
            </div>
          </div>

          <% if profile.bio.present? %>
            <p class="mt-4 text-gray-600 text-sm line-clamp-3"><%= truncate(profile.bio, length: 120) %></p>
          <% end %>

          <% if profile.skills.present? %>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <% profile.skills_list.first(3).each do |skill| %>
                <%= link_to skill, profiles_path(skill: skill), class: "inline-block bg-purple-50 text-purple-700 text-xs px-2.5 py-1 rounded-full hover:bg-purple-100 transition-colors" %>
              <% end %>
              <% if profile.skills_list.size > 3 %>
                <span class="text-xs text-gray-400 py-1">+<%= profile.skills_list.size - 3 %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
