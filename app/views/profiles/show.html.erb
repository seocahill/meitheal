<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Directory", profiles_path, class: "text-pink-600 hover:text-pink-800" %>
  </div>

  <div class="bg-white rounded-lg shadow-lg p-8">
    <!-- Header with avatar and basic info -->
    <div class="flex flex-col md:flex-row items-start gap-6 mb-8">
      <% if @profile.avatar.attached? %>
        <%= image_tag @profile.avatar, class: "w-32 h-32 rounded-full object-cover" %>
      <% else %>
        <div class="w-32 h-32 rounded-full bg-pink-100 flex items-center justify-center text-pink-600 text-4xl font-bold">
          <%= @profile.name.first.upcase %>
        </div>
      <% end %>

      <div class="flex-1">
        <h1 class="text-3xl font-bold mb-2"><%= @profile.name %></h1>

        <% if @profile.location.present? %>
          <p class="text-gray-600 mb-2"><%= @profile.location %></p>
        <% end %>

        <% if @profile.website.present? %>
          <p class="mb-2">
            <%= link_to @profile.website, @profile.website, class: "text-pink-600 hover:text-pink-800", target: "_blank" %>
          </p>
        <% end %>

        <% if @profile.skills.present? %>
          <div class="flex flex-wrap gap-2 mt-4">
            <% @profile.skills_list.each do |skill| %>
              <%= link_to skill, profiles_path(skill: skill), class: "inline-block bg-pink-100 text-pink-700 text-sm px-3 py-1 rounded-full hover:bg-pink-200" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if authenticated? && @profile.user == Current.user %>
        <%= link_to "Edit Profile", my_profile_path, class: "bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700" %>
      <% end %>
    </div>

    <!-- Bio -->
    <% if @profile.bio.present? %>
      <div class="mb-8">
        <h2 class="text-xl font-bold mb-4">About</h2>
        <div class="prose max-w-none">
          <%= simple_format(@profile.bio) %>
        </div>
      </div>
    <% end %>

    <!-- Portfolio -->
    <% if @profile.portfolio_images.attached? %>
      <div class="mb-8">
        <h2 class="text-xl font-bold mb-4">Portfolio</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          <% @profile.portfolio_images.each do |image| %>
            <%= image_tag image, class: "w-full h-48 object-cover rounded-lg" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
