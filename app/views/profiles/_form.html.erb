<%= form_with model: profile, url: my_profile_path, class: "space-y-6" do |form| %>
  <% if profile.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <h2 class="font-bold"><%= pluralize(profile.errors.count, "error") %> prohibited this profile from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Display Name", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div>
    <%= form.label :avatar, class: "block text-sm font-medium text-gray-700" %>
    <% if profile.avatar.attached? %>
      <div class="mt-2 mb-2">
        <%= image_tag profile.avatar, class: "w-24 h-24 rounded-full object-cover" %>
      </div>
    <% end %>
    <%= form.file_field :avatar, accept: "image/*", class: "mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-pink-50 file:text-pink-700 hover:file:bg-pink-100" %>
  </div>

  <div>
    <%= form.label :bio, "About You", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :bio, rows: 6, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div>
    <%= form.label :skills, "Skills (comma-separated)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :skills, placeholder: "e.g., painting, sculpture, digital art", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
    <p class="mt-1 text-sm text-gray-500">Others can search for you by these skills</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :location, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :location, placeholder: "e.g., Ballina, Co. Mayo", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
    </div>

    <div>
      <%= form.label :website, class: "block text-sm font-medium text-gray-700" %>
      <%= form.url_field :website, placeholder: "https://yourwebsite.com", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
    </div>
  </div>

  <div>
    <%= form.label :portfolio_images, "Portfolio Images", class: "block text-sm font-medium text-gray-700" %>
    <% if profile.portfolio_images.attached? %>
      <div class="mt-2 mb-2 grid grid-cols-4 gap-2">
        <% profile.portfolio_images.each do |image| %>
          <%= image_tag image, class: "w-full h-20 object-cover rounded" %>
        <% end %>
      </div>
    <% end %>
    <%= form.file_field :portfolio_images, multiple: true, accept: "image/*", class: "mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-pink-50 file:text-pink-700 hover:file:bg-pink-100" %>
    <p class="mt-1 text-sm text-gray-500">You can select multiple images. New uploads will be added to existing ones.</p>
  </div>

  <div class="flex items-center gap-4">
    <%= form.check_box :visible, class: "rounded border-gray-300 text-pink-600 focus:ring-pink-500" %>
    <%= form.label :visible, "Show my profile in the public directory", class: "text-sm text-gray-700" %>
  </div>

  <div class="flex items-center justify-end gap-4">
    <%= link_to "Cancel", profiles_path, class: "text-gray-600 hover:text-gray-800" %>
    <%= form.submit class: "bg-pink-600 text-white px-6 py-2 rounded hover:bg-pink-700 cursor-pointer" %>
  </div>
<% end %>
