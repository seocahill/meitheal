<%= form_with model: profile, url: my_profile_path, class: "space-y-6" do |form| %>
  <% if profile.errors.any? %>
    <div class="form-error">
      <h2><%= pluralize(profile.errors.count, "error") %> prohibited this profile from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Display Name", class: "form-label" %>
    <%= form.text_field :name, class: "form-input" %>
  </div>

  <div>
    <%= form.label :avatar, class: "form-label" %>
    <% if profile.avatar.attached? %>
      <div class="mt-2 mb-2">
        <%= image_tag profile.avatar, class: "w-24 h-24 rounded-full object-cover ring-2 ring-purple-100" %>
      </div>
    <% end %>
    <%= form.file_field :avatar, accept: "image/*", class: "form-file" %>
  </div>

  <div>
    <%= form.label :bio, "About You", class: "form-label" %>
    <%= form.text_area :bio, rows: 6, class: "form-input" %>
  </div>

  <div>
    <%= form.label :skills, "Skills (comma-separated)", class: "form-label" %>
    <%= form.text_field :skills, placeholder: "e.g., painting, sculpture, digital art", class: "form-input" %>
    <p class="form-hint">Others can search for you by these skills</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :location, class: "form-label" %>
      <%= form.text_field :location, placeholder: "e.g., Ballina, Co. Mayo", class: "form-input" %>
    </div>

    <div>
      <%= form.label :website, class: "form-label" %>
      <%= form.url_field :website, placeholder: "https://yourwebsite.com", class: "form-input" %>
    </div>
  </div>

  <div>
    <%= form.label :portfolio_images, "Portfolio Images", class: "form-label" %>
    <% if profile.portfolio_images.attached? %>
      <div class="mt-2 mb-2 grid grid-cols-4 gap-2">
        <% profile.portfolio_images.each do |image| %>
          <%= image_tag image, class: "w-full h-20 object-cover rounded-lg" %>
        <% end %>
      </div>
    <% end %>
    <%= form.file_field :portfolio_images, multiple: true, accept: "image/*", class: "form-file" %>
    <p class="form-hint">You can select multiple images. New uploads will be added to existing ones.</p>
  </div>

  <div class="flex items-center gap-3">
    <%= form.check_box :visible, class: "form-checkbox" %>
    <%= form.label :visible, "Show my profile in the public directory", class: "text-sm text-gray-700" %>
  </div>

  <div class="flex items-center justify-end gap-4 pt-4 border-t border-gray-100">
    <%= link_to "Cancel", profiles_path, class: "text-gray-600 hover:text-gray-900" %>
    <%= form.submit class: "btn-primary text-white px-6 py-2.5 rounded-xl font-medium cursor-pointer" %>
  </div>
<% end %>
