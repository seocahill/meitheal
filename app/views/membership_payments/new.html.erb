<div class="max-w-lg mx-auto px-4" data-controller="sumup-payment">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Pay Membership</h1>

  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Membership Details</h2>

    <dl class="space-y-3">
      <div class="flex justify-between">
        <dt class="text-gray-600">Type</dt>
        <dd class="font-medium"><%= @membership.membership_type.humanize %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-600">Amount</dt>
        <dd class="font-medium text-lg">&euro;<%= number_with_precision(@amount_cents / 100.0, precision: 2) %></dd>
      </div>
      <% if @membership.expires_on %>
        <div class="flex justify-between">
          <dt class="text-gray-600">Current Expiry</dt>
          <dd class="font-medium"><%= @membership.expires_on.strftime("%d %B %Y") %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="bg-white shadow rounded-lg p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Payment</h2>

    <div
      id="sumup-card"
      data-sumup-payment-target="cardWidget"
      class="min-h-[200px]">
      <div class="text-center py-8 text-gray-500" data-sumup-payment-target="loading">
        Loading payment form...
      </div>
    </div>

    <div data-sumup-payment-target="error" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700"></div>

    <button
      type="button"
      data-action="click->sumup-payment#initiatePayment"
      data-sumup-payment-target="payButton"
      data-membership-id="<%= @membership.id %>"
      class="mt-6 w-full bg-pink-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-pink-700 disabled:opacity-50 disabled:cursor-not-allowed">
      Pay &euro;<%= number_with_precision(@amount_cents / 100.0, precision: 2) %>
    </button>

    <p class="mt-4 text-sm text-gray-500 text-center">
      Payments are securely processed by SumUp.
    </p>
  </div>

  <%= link_to "Cancel", my_profile_path, class: "block mt-6 text-center text-gray-600 hover:text-gray-800" %>
</div>

<script src="https://gateway.sumup.com/gateway/ecom/card/v2/sdk.js"></script>
