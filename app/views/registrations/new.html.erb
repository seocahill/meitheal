<div class="max-w-lg mx-auto px-4 sm:px-6">
  <h1 class="text-3xl font-bold text-gray-900 mb-2">Join us</h1>
  <p class="text-gray-600 mb-8">Membership of THENCF is free and all are welcome to join.</p>

  <div class="card p-6 mb-8">
    <%= form_with model: @user, url: registration_path, class: "space-y-6" do |form| %>
      <% if @user.errors.any? %>
        <div class="form-error">
          <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <label class="form-label">Your name</label>
        <%= form.text_field :name, required: true, autofocus: true, placeholder: "Enter your full name", class: "form-input" %>
      </div>

      <div>
        <label class="form-label">Email address</label>
        <%= form.email_field :email_address, required: true, autocomplete: "email", placeholder: "Enter your email address", class: "form-input" %>
      </div>

      <div>
        <label class="form-label">Password</label>
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Choose a password", minlength: 8, class: "form-input" %>
        <p class="form-hint">At least 8 characters</p>
      </div>

      <div>
        <label class="form-label">Confirm password</label>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm your password", class: "form-input" %>
      </div>

      <%= recaptcha_v3(action: "registration", turbo: true) %>

      <div class="pt-4">
        <%= form.submit "Create Account", class: "w-full btn-primary text-white px-6 py-2.5 rounded-xl font-medium cursor-pointer text-center" %>
      </div>
    <% end %>

    <p class="text-sm text-gray-600 m-4">
      Your name and email are used for our mailing list and one-to-one member communication only. No other data is collected. This site has no cookies or third-party trackers.
    </p>

    <p class="mt-6 text-center text-sm text-gray-600">
      Already have an account?
      <%= link_to "Sign in", new_session_path, class: "text-purple-600 hover:text-purple-700 font-medium" %>
    </p>
  </div>

  <div class="card p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-3">Full membership</h2>
    <p class="text-sm text-gray-600 mb-3">
      After your sign-up has been approved by an admin, you can optionally become a full member
      by paying an annual contribution to help fund the cooperative.
    </p>
    <p class="text-sm text-gray-600 mb-4">
      Full membership gives you voting rights at the AGM and the ability to book the NCF space for your event.
    </p>

    <h3 class="text-sm font-semibold text-gray-700 mb-2">Annual contribution</h3>
    <ul class="text-sm text-gray-600 space-y-1 mb-4">
      <li>Full membership: <span class="font-medium text-gray-900">&euro;20</span></li>
      <li>Student / OAP / Unwaged: <span class="font-medium text-gray-900">&euro;10</span></li>
      <li>Under 18: <span class="font-medium text-gray-900">&euro;5</span></li>
    </ul>

    <p class="text-xs text-gray-500">
      If you are unable to pay a contribution, you may also volunteer your time in lieu of payment.
    </p>
  </div>
</div>
