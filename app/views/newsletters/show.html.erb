<div class="max-w-4xl mx-auto px-4">
  <article class="bg-white shadow rounded-lg p-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-6"><%= @newsletter.subject %></h1>

    <% if @newsletter.sent_at %>
      <p class="text-sm text-gray-500 mb-6"><%= @newsletter.sent_at.strftime("%B %d, %Y") %></p>
    <% end %>

    <div class="prose prose-lg max-w-none">
      <%= @newsletter.content %>
    </div>
  </article>

  <div class="mt-6">
    <%= link_to "Back to Newsletters", newsletter_page_path, class: "text-gray-600 hover:text-gray-800" %>
  </div>
</div>
