<div class="max-w-6xl mx-auto px-4">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Newsletters</h1>
    <%= link_to "New Newsletter", new_newsletter_path, class: "bg-pink-600 text-white px-4 py-2 rounded hover:bg-pink-700" %>
  </div>

  <div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subject</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Updated</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @newsletters.each do |newsletter| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <%= link_to newsletter.subject, edit_newsletter_path(newsletter), class: "text-pink-600 hover:text-pink-800 font-medium" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if newsletter.sent? %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                  Sent <%= newsletter.sent_at.strftime("%b %d") %>
                </span>
              <% else %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                  Draft
                </span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= newsletter.updated_at.strftime("%b %d, %Y") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "Edit", edit_newsletter_path(newsletter), class: "text-pink-600 hover:text-pink-800 mr-4" %>
              <% unless newsletter.sent? %>
                <%= button_to "Delete", newsletter_path(newsletter), method: :delete, class: "text-red-600 hover:text-red-800", data: { turbo_confirm: "Are you sure?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
