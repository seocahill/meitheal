<div class="mx-auto max-w-7xl py-12 px-4 sm:px-6 lg:flex lg:items-center lg:justify-between lg:py-16 lg:px-8">
  <div class="prose lg:prose-xl">
    <div class="flex justify-between items-center mb-8">
      <h2>News & Updates</h2>
      <% if authenticated? %>
        <%= link_to "New Post", new_post_path, class: "text-sm btn-primary text-white px-4 py-2 rounded-lg font-medium no-underline" %>
      <% end %>
    </div>

    <% if @posts.empty? %>
      <p class="text-gray-500">No posts yet.</p>
      <% if authenticated? %>
        <p>
          <%= link_to "Create the first post", new_post_path %>
        </p>
      <% end %>
    <% else %>
      <% @posts.each do |post| %>
        <article class="mb-8">
          <% if post.featured_image.attached? %>
            <div class="mb-4">
              <%= link_to post_path(post.slug) do %>
                <%= image_tag post.featured_image, alt: post.title, class: "w-full h-64 object-cover rounded-lg" %>
              <% end %>
            </div>
          <% end %>
          <h3><%= link_to post.title, post_path(post.slug) %></h3>
          <p class="text-gray-600 text-sm"><%= post.published_at&.strftime('%B %d, %Y') %></p>
          <% if post.excerpt.present? %>
            <p><%= post.excerpt %></p>
          <% end %>
          <%= link_to "Read more", post_path(post.slug) %>
        </article>
      <% end %>

      <%= pagy_nav(@pagy) if @pagy %>
    <% end %>
  </div>
</div>
