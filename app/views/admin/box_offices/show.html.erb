<% content_for :title, "Box Office — #{@event.title}" %>

<div class="max-w-md mx-auto px-4 -mt-4">
  <div class="mb-4">
    <%= link_to "← Ticket sales", admin_ticket_sale_path(@event), class: "text-sm text-gray-400 hover:text-gray-600" %>
    <h1 class="text-xl font-bold mt-1"><%= @event.title %></h1>
    <p class="text-sm text-gray-500">Starts <%= @event.starts_at.strftime("%a %-d %b, %H:%M") %></p>
  </div>

  <%# Headcount %>
  <div class="bg-white rounded-xl border border-gray-200 p-4 mb-3">
    <p class="text-xs text-gray-500 uppercase tracking-wide text-center">In the room</p>
    <p class="text-5xl font-bold text-center my-2 <%= @event.audience_full? ? "text-rose-600" : "text-gray-900" %>">
      <%= @event.audience_count %><% if @event.capacity.present? %><span class="text-2xl text-gray-400"> / <%= @event.capacity %></span><% end %>
    </p>
    <div class="grid grid-cols-2 gap-3 mt-3">
      <%= button_to "− Someone left", person_left_admin_box_office_path(@event), method: :patch,
            class: "w-full py-3 rounded-lg bg-gray-100 text-gray-800 font-medium active:bg-gray-200" %>
      <%= button_to "+ Came back", person_returned_admin_box_office_path(@event), method: :patch,
            disabled: @event.audience_left_count.zero?,
            class: "w-full py-3 rounded-lg bg-gray-100 text-gray-800 font-medium active:bg-gray-200 disabled:opacity-40" %>
    </div>
  </div>

  <%# Box office status %>
  <div class="bg-white rounded-xl border border-gray-200 p-4 mb-4 flex items-center justify-between gap-3">
    <div>
      <% if @event.box_office_open? %>
        <p class="font-semibold text-emerald-700">Box office open</p>
        <p class="text-xs text-gray-500">Closes <%= @event.box_office_closes_at.strftime("%H:%M") %></p>
      <% else %>
        <p class="font-semibold text-rose-700">Box office closed</p>
        <p class="text-xs text-gray-500">
          <% reason = @event.box_office_closed_reason %>
          <% if reason == :manual %>Closed manually
          <% elsif reason == :full %>The room is full
          <% else %>Closed at <%= @event.box_office_closes_at.strftime("%H:%M") %>
          <% end %>
        </p>
      <% end %>
    </div>
    <% if @event.box_office_closed_manually? %>
      <%= button_to "Reopen", reopen_admin_box_office_path(@event), method: :patch,
            class: "px-4 py-2 rounded-lg border border-gray-300 text-sm font-medium" %>
    <% elsif @event.box_office_open? %>
      <%= button_to "Close", close_admin_box_office_path(@event), method: :patch,
            form: { data: { turbo_confirm: "Close the box office? Online and door sales will stop." } },
            class: "px-4 py-2 rounded-lg bg-rose-600 text-white text-sm font-medium" %>
    <% end %>
  </div>

  <%# Search %>
  <%= form_with url: admin_box_office_path(@event), method: :get, class: "flex gap-2 mb-3" do %>
    <%= search_field_tag :q, @query, placeholder: "Name or email", autocomplete: "off",
          class: "flex-1 min-w-0 border border-gray-300 rounded-lg px-3 py-3 text-base" %>
    <%= submit_tag "Search", name: nil, class: "px-4 py-3 rounded-lg bg-purple-600 text-white font-medium" %>
  <% end %>
  <% if @query.present? %>
    <%= link_to "Clear search", admin_box_office_path(@event), class: "block text-sm text-purple-600 mb-3" %>
  <% end %>

  <%# Bookings %>
  <ul class="space-y-2 mb-6">
    <% @tickets.each do |ticket| %>
      <li class="rounded-xl border <%= ticket.fully_checked_in? ? "border-emerald-200 bg-emerald-50" : "border-gray-200 bg-white" %> p-3">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-semibold text-gray-900 truncate"><%= ticket.buyer_name %></p>
            <% if ticket.buyer_email.present? %>
              <p class="text-xs text-gray-500 truncate"><%= ticket.buyer_email %></p>
            <% end %>
          </div>
          <span class="flex-shrink-0 text-sm font-medium <%= ticket.fully_checked_in? ? "text-emerald-700" : "text-gray-600" %>">
            <%= ticket.checked_in_count %>/<%= ticket.quantity %> in
          </span>
        </div>

        <div class="flex gap-2 mt-3">
          <% unless ticket.fully_checked_in? %>
            <%= button_to "Check in 1", check_in_admin_box_office_path(@event), params: { ticket_id: ticket.id, count: 1 },
                  form_class: "flex-1", class: "w-full py-3 rounded-lg bg-emerald-600 text-white font-medium active:bg-emerald-700" %>
            <% if ticket.remaining_to_check_in > 1 %>
              <%= button_to "All #{ticket.remaining_to_check_in}", check_in_admin_box_office_path(@event), params: { ticket_id: ticket.id, count: ticket.remaining_to_check_in },
                    form_class: "flex-1", class: "w-full py-3 rounded-lg bg-emerald-700 text-white font-medium active:bg-emerald-800" %>
            <% end %>
          <% end %>
          <% if ticket.checked_in_count > 0 %>
            <%= button_to "Undo", undo_check_in_admin_box_office_path(@event), params: { ticket_id: ticket.id },
                  class: "px-4 py-3 rounded-lg border border-gray-300 text-gray-700 text-sm" %>
          <% end %>
        </div>
      </li>
    <% end %>
    <% if @tickets.empty? %>
      <li class="text-center text-gray-400 py-8"><%= @query.present? ? "No bookings match “#{@query}”." : "No bookings yet." %></li>
    <% end %>
  </ul>

  <%# Walk-up sales %>
  <% if @event.box_office_open? %>
    <div class="bg-white rounded-xl border border-gray-200 p-4 mb-8">
      <h2 class="font-semibold text-gray-900 mb-1">Walk-up</h2>
      <p class="text-xs text-gray-500 mb-3">Take payment at the door, then add them here. They're checked in straight away.</p>
      <%= form_with url: walk_up_admin_box_office_path(@event), method: :post, class: "flex gap-2" do %>
        <%= text_field_tag :buyer_name, nil, required: true, placeholder: "Name",
              class: "flex-1 min-w-0 border border-gray-300 rounded-lg px-3 py-3 text-base" %>
        <%= number_field_tag :quantity, 1, min: 1, inputmode: "numeric",
              class: "w-16 border border-gray-300 rounded-lg px-2 py-3 text-base text-center" %>
        <%= submit_tag "Add", class: "px-4 py-3 rounded-lg bg-purple-600 text-white font-medium" %>
      <% end %>
    </div>
  <% end %>
</div>
