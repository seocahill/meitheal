<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Manage Bookings</h1>
    <%= link_to "View Calendar", calendar_path, class: "bg-pink-600 text-white px-4 py-2 rounded hover:bg-pink-700" %>
  </div>

  <% dates = @date_filter.to_params %>
  <% base = { q: params[:q], space_id: params[:space_id] }.merge(dates).compact_blank %>
  <% filters = base.merge(status: params[:status], paid: params[:paid], overdue: params[:overdue], when: params[:when]).compact_blank %>
  <% tab = "px-4 py-2 rounded-lg text-sm font-medium" %>
  <% idle = "text-gray-600 hover:bg-gray-100" %>

  <!-- Filter tabs -->
  <div class="flex flex-wrap gap-2 mb-4">
    <%= link_to "Upcoming", admin_bookings_path(base.except(*dates.keys)), class: "#{tab} #{filters.except(:q, :space_id).empty? ? 'bg-purple-100 text-purple-700' : idle}" %>
    <%= link_to admin_bookings_path(base.merge(paid: "unpaid")), data: { count: :unpaid }, class: "#{tab} #{params[:paid] == 'unpaid' && params[:overdue].blank? ? 'bg-red-100 text-red-700' : idle}" do %>
      Unpaid <span class="font-semibold"><%= @counts[:unpaid] %></span>
    <% end %>
    <%= link_to admin_bookings_path(base.merge(overdue: "1")), data: { count: :overdue }, title: "Unpaid and ended more than two weeks ago. These block the booker from making a new booking.", class: "#{tab} #{params[:overdue].present? ? 'bg-rose-100 text-rose-700' : idle}" do %>
      Overdue <span class="font-semibold"><%= @counts[:overdue] %></span>
    <% end %>
    <%= link_to "Paid", admin_bookings_path(base.merge(paid: "paid")), class: "#{tab} #{params[:paid] == 'paid' ? 'bg-blue-100 text-blue-700' : idle}" %>
    <%= link_to admin_bookings_path(base.merge(status: "pending")), data: { count: :pending }, class: "#{tab} #{params[:status] == 'pending' ? 'bg-amber-100 text-amber-700' : idle}" do %>
      Pending Confirmation <span class="font-semibold"><%= @counts[:pending] %></span>
    <% end %>
    <%= link_to "Confirmed", admin_bookings_path(base.merge(status: "confirmed")), class: "#{tab} #{params[:status] == 'confirmed' ? 'bg-green-100 text-green-700' : idle}" %>
    <%= link_to "Cancelled", admin_bookings_path(base.merge(status: "cancelled")), class: "#{tab} #{params[:status] == 'cancelled' ? 'bg-gray-200 text-gray-700' : idle}" %>
  </div>

  <!-- Search, space and timeframe -->
  <%= form_with url: admin_bookings_path, method: :get, class: "flex flex-wrap items-end gap-3 mb-6" do |f| %>
    <% %i[status paid overdue].each do |key| %>
      <%= hidden_field_tag key, params[key], id: nil if params[key].present? %>
    <% end %>
    <div>
      <label for="q" class="block text-xs font-medium text-gray-500 mb-1">Search</label>
      <%= text_field_tag :q, params[:q], placeholder: "Title, name or email", class: "w-56 border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>
    <div>
      <label for="space_id" class="block text-xs font-medium text-gray-500 mb-1">Space</label>
      <%= select_tag :space_id, options_from_collection_for_select(@spaces, :id, :name, params[:space_id]), include_blank: "All spaces", class: "border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>
    <%= render "admin/shared/date_range_filter", filter: @date_filter, label: "Starts" %>
    <div>
      <label for="when" class="block text-xs font-medium text-gray-500 mb-1">When</label>
      <%= select_tag :when, options_for_select([ [ "Any time", "all" ], [ "Upcoming", "upcoming" ], [ "Already started", "past" ] ], params[:when]), include_blank: "Default", class: "border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>
    <%= submit_tag "Apply", name: nil, class: "bg-gray-800 text-white px-4 py-2 rounded-lg text-sm cursor-pointer" %>
    <% if filters.present? %>
      <%= link_to "Clear", admin_bookings_path, class: "text-sm text-gray-500 hover:text-gray-700 py-2" %>
    <% end %>
  <% end %>

  <div class="bg-white shadow rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Booking</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Space</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date/Time</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @bookings.any? %>
          <% @bookings.each do |booking| %>
            <tr>
              <td class="px-4 py-3">
                <div class="font-medium text-gray-900"><%= booking.title %></div>
                <% if booking.description.present? %>
                  <div class="text-sm text-gray-500"><%= truncate(booking.description, length: 40) %></div>
                <% end %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                <%= booking.space.name %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                <%= booking.user.email_address %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                <div><%= booking.starts_at.strftime("%b %d, %Y") %></div>
                <div class="text-xs text-gray-500"><%= booking.starts_at.strftime("%l:%M %p") %> - <%= booking.ends_at.strftime("%l:%M %p") %></div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% case booking.status %>
                <% when "pending" %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">Pending</span>
                <% when "confirmed" %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Confirmed</span>
                <% when "cancelled" %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Cancelled</span>
                <% end %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% if booking.confirmed? %>
                  <% if booking.paid %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Paid</span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Unpaid</span>
                    <% if booking.payment_overdue? %>
                      <span class="block text-xs text-rose-700 mt-1">Overdue, ended <%= time_ago_in_words(booking.ends_at) %> ago</span>
                    <% elsif booking.ends_at < Time.current %>
                      <span class="block text-xs text-gray-500 mt-1">Ended <%= time_ago_in_words(booking.ends_at) %> ago</span>
                    <% end %>
                  <% end %>
                <% else %>
                  <span class="text-xs text-gray-400">N/A</span>
                <% end %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-right text-sm">
                <div class="flex justify-end gap-2">
                  <% if booking.pending? %>
                    <%= button_to "Confirm", confirm_booking_path(booking), method: :patch, class: "px-3 py-1.5 rounded text-xs font-medium text-white bg-green-600 hover:bg-green-700 transition-colors" %>
                  <% end %>
                  <% if booking.confirmed? %>
                    <%= button_to booking.paid ? "Mark Unpaid" : "Mark Paid",
                        toggle_paid_admin_booking_path(booking, filters.merge(page: params[:page]).compact_blank),
                        method: :patch,
                        class: "px-3 py-1.5 rounded text-xs font-medium text-white transition-colors #{booking.paid ? 'bg-amber-600 hover:bg-amber-700' : 'bg-blue-600 hover:bg-blue-700'}" %>
                  <% end %>
                  <%= button_to "Edit", edit_booking_path(booking), method: :get, class: "px-3 py-1.5 rounded text-xs font-medium text-white bg-purple-600 hover:bg-purple-700 transition-colors" %>
                  <% unless booking.cancelled? %>
                    <%= button_to "Cancel", cancel_booking_path(booking), method: :patch, data: { turbo_confirm: "Cancel this booking?" }, class: "px-3 py-1.5 rounded text-xs font-medium text-white bg-red-600 hover:bg-red-700 transition-colors" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="px-6 py-12 text-center text-gray-500">
              No bookings found matching the selected filters.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <nav class="mt-8 text-center text-sm">
    <%== @pagy.series_nav %>
  </nav>
</div>
