<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Import Calendar</h1>
    <p class="text-gray-600 mt-1">Import bookings from an iCal (.ics) file. Events will be created as confirmed bookings.</p>
  </div>

  <%= form_with url: admin_calendar_imports_path, method: :post, multipart: true do |f| %>
    <div class="card p-6 space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Calendar File (.ics)</label>
        <%= file_field_tag :ical_file, accept: ".ics,text/calendar", required: true,
            class: "block w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-medium file:bg-pink-50 file:text-pink-700 hover:file:bg-pink-100" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Assign to Space</label>
        <%= select_tag :space_id,
            options_from_collection_for_select(@spaces, :id, :name),
            prompt: "Select a space...",
            required: true,
            class: "block w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-pink-500" %>
        <p class="text-xs text-gray-500 mt-1">All imported events will be assigned to this space.</p>
      </div>

      <div class="flex items-center justify-between pt-2">
        <%= link_to "Cancel", calendar_path, class: "text-gray-600 hover:text-gray-800 text-sm" %>
        <%= f.submit "Import Events", class: "btn-primary text-white px-6 py-2 rounded-xl font-medium text-sm cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>
