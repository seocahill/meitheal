<%= form_with model: [:admin, user], class: "space-y-6" do |form| %>
  <% if user.errors.any? %>
    <div class="form-error">
      <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :email_address, class: "form-label" %>
    <%= form.email_field :email_address, class: "form-input", autocomplete: "off" %>
  </div>

  <div>
    <%= form.label :password, user.persisted? ? "Password (leave blank to keep current)" : "Password", class: "form-label" %>
    <%= form.password_field :password, class: "form-input", autocomplete: "new-password", required: user.new_record? %>
  </div>

  <div>
    <%= form.label :role, class: "form-label" %>
    <%= form.select :role, User.roles.keys.map { |r| [r.capitalize, r] }, {}, class: "form-input" %>
    <p class="form-hint">
      <strong>Viewer:</strong> Can view content and create their own events<br>
      <strong>Editor:</strong> Can edit all content and publish events<br>
      <strong>Owner:</strong> Full administrative access
    </p>
  </div>

  <div class="flex items-center justify-end gap-4 pt-4 border-t border-gray-100">
    <%= link_to "Cancel", admin_users_path, class: "text-gray-600 hover:text-gray-900" %>
    <%= form.submit class: "btn-primary text-white px-6 py-2.5 rounded-xl font-medium cursor-pointer" %>
  </div>
<% end %>
