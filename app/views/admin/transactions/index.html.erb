<div class="max-w-5xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">SumUp Transactions</h1>
      <p class="text-gray-600 mt-1"><%= @transactions.size %> transaction<%= @transactions.size == 1 ? "" : "s" %></p>
    </div>
    <div class="w-64">
      <%= form_with url: admin_transactions_path, method: :get, local: true do |f| %>
        <div class="relative">
          <input
            type="text"
            name="q"
            value="<%= params[:q] %>"
            placeholder="Search by code, status, type..."
            class="w-full pl-3 pr-10 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
          >
          <% if params[:from].present? %>
            <input type="hidden" name="from" value="<%= params[:from] %>">
          <% end %>
          <% if params[:to].present? %>
            <input type="hidden" name="to" value="<%= params[:to] %>">
          <% end %>
          <% if params[:page].present? %>
            <input type="hidden" name="page" value="<%= params[:page] %>">
          <% end %>
          <button type="submit" class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"></path>
            </svg>
          </button>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Date filters -->
  <%= form_with url: admin_transactions_path, method: :get, class: "mb-6" do |f| %>
    <div class="flex gap-4 items-end bg-white rounded-xl border border-gray-200 px-4 py-3">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">From</label>
        <%= date_field_tag :from, params[:from], class: "border border-gray-300 rounded px-2 py-1 text-sm" %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">To</label>
        <%= date_field_tag :to, params[:to], class: "border border-gray-300 rounded px-2 py-1 text-sm" %>
      </div>
      <%= f.submit "Filter", class: "btn-primary text-white px-4 py-1.5 rounded-lg text-sm cursor-pointer" %>
      <% if params[:from].present? || params[:to].present? %>
        <%= link_to "Clear", admin_transactions_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <% end %>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="bg-red-50 border border-red-200 rounded-lg px-4 py-3 text-sm text-red-700 mb-4">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="card overflow-hidden">
    <% if @transactions.any? %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Date</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Member</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Code</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Amount</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Status</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Type</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Payment</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @transactions.each do |txn| %>
            <% payment = @payments_by_transaction_id[txn["id"]] %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-gray-600">
                <% if txn["timestamp"].present? %>
                  <%= Time.parse(txn["timestamp"]).strftime("%d %b %Y %H:%M") rescue txn["timestamp"] %>
                <% end %>
              </td>
              <td class="px-4 py-3 text-gray-700">
                <% if payment&.membership&.user %>
                  <%= payment.membership.user.name || payment.membership.user.email_address %>
                <% else %>
                  -
                <% end %>
              </td>
              <td class="px-4 py-3 font-mono text-xs text-gray-500"><%= txn["transaction_code"] %></td>
              <td class="px-4 py-3 font-medium">
                <%= number_to_currency(txn["amount"], unit: "€", format: "%u%n") %>
                <span class="text-xs text-gray-400"><%= txn["currency"] %></span>
              </td>
              <td class="px-4 py-3">
                <% status_class = case txn["status"]
                   when "SUCCESSFUL" then "bg-green-100 text-green-800"
                   when "FAILED", "CANCELLED" then "bg-red-100 text-red-800"
                   when "REFUNDED", "CHARGE_BACK" then "bg-amber-100 text-amber-800"
                   else "bg-gray-100 text-gray-600"
                   end %>
                <span class="px-2 py-0.5 rounded text-xs font-medium <%= status_class %>">
                  <%= txn["status"] %>
                </span>
              </td>
              <td class="px-4 py-3 text-gray-500"><%= txn["type"] %></td>
              <td class="px-4 py-3 text-gray-500"><%= txn["payment_type"] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="px-6 py-12 text-center text-gray-500">
        No transactions found.
      </div>
    <% end %>
  </div>

  <% if @transactions.any? && (@page.present? && (@page > 1 || @has_more)) %>
    <div class="mt-4 flex items-center justify-between text-sm text-gray-600">
      <div>
        Page <%= @page %>
      </div>
      <div class="flex gap-2">
        <% if @page > 1 %>
          <%= link_to "Previous",
                      admin_transactions_path(
                        from: params[:from].presence,
                        to: params[:to].presence,
                        q: params[:q].presence,
                        page: @page - 1
                      ),
                      class: "px-3 py-1 border border-gray-300 rounded-lg hover:bg-gray-50" %>
        <% end %>
        <% if @has_more %>
          <%= link_to "Next",
                      admin_transactions_path(
                        from: params[:from].presence,
                        to: params[:to].presence,
                        q: params[:q].presence,
                        page: @page + 1
                      ),
                      class: "px-3 py-1 border border-gray-300 rounded-lg hover:bg-gray-50" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
