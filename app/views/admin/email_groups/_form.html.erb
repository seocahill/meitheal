<%= form_with model: [:admin, email_group], class: "space-y-6" do |form| %>
  <% if email_group.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <ul class="list-disc list-inside">
        <% email_group.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div>
    <%= form.label :local_part, "Email Address Prefix", class: "block text-sm font-medium text-gray-700" %>
    <div class="mt-1 flex rounded-md shadow-sm">
      <%= form.text_field :local_part, class: "flex-1 block w-full rounded-none rounded-l-md border-gray-300 focus:border-pink-500 focus:ring-pink-500", placeholder: "artists" %>
      <span class="inline-flex items-center px-3 rounded-r-md border border-l-0 border-gray-300 bg-gray-50 text-gray-500 text-sm">
        @thencf.art
      </span>
    </div>
    <p class="mt-1 text-sm text-gray-500">Lowercase letters, numbers, and hyphens only</p>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div class="flex items-center">
    <%= form.check_box :active, class: "h-4 w-4 text-pink-600 focus:ring-pink-500 border-gray-300 rounded" %>
    <%= form.label :active, "Active (can receive and send emails)", class: "ml-2 block text-sm text-gray-900" %>
  </div>

  <div class="flex items-center justify-end gap-4">
    <%= link_to "Cancel", admin_email_groups_path, class: "text-gray-600 hover:text-gray-800" %>
    <%= form.submit class: "bg-pink-600 text-white px-6 py-2 rounded hover:bg-pink-700 cursor-pointer" %>
  </div>
<% end %>
