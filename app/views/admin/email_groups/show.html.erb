<div class="max-w-4xl mx-auto px-4">
  <div class="flex justify-between items-start mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @email_group.name %></h1>
      <p class="text-gray-600 mt-2"><%= @email_group.email_address %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_admin_email_group_path(@email_group), class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
      <%= link_to "Back", admin_email_groups_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Details</h2>
    <dl class="grid grid-cols-2 gap-4">
      <div>
        <dt class="text-sm font-medium text-gray-500">Status</dt>
        <dd class="mt-1">
          <% if @email_group.active? %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
          <% else %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Inactive</span>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Members</dt>
        <dd class="mt-1 text-gray-900"><%= @email_group.members.count %></dd>
      </div>
      <% if @email_group.description.present? %>
        <div class="col-span-2">
          <dt class="text-sm font-medium text-gray-500">Description</dt>
          <dd class="mt-1 text-gray-900"><%= @email_group.description %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6 mb-8">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-semibold text-gray-900">Members (<%= @email_group.members.count %>)</h2>
    </div>
    <% if @email_group.members.any? %>
      <ul class="divide-y divide-gray-200">
        <% @email_group.members.each do |member| %>
          <li class="py-3 flex justify-between items-center">
            <span class="text-gray-900"><%= member.email_address %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500">No members in this group yet.</p>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Recent Emails</h2>
    <% if @email_group.archived_emails.recent.any? %>
      <ul class="divide-y divide-gray-200">
        <% @email_group.archived_emails.recent.order(received_at: :desc).limit(10).each do |email| %>
          <li class="py-3">
            <div class="flex justify-between items-start">
              <div>
                <p class="font-medium text-gray-900"><%= email.subject %></p>
                <p class="text-sm text-gray-500">From: <%= email.from_address %></p>
              </div>
              <span class="text-sm text-gray-400"><%= time_ago_in_words(email.received_at) %> ago</span>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500">No recent emails.</p>
    <% end %>
  </div>
</div>
