<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Membership Details</h1>
    <div class="flex gap-4">
      <%= link_to "Edit", edit_admin_membership_path(@membership), class: "bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700" %>
      <%= link_to "Back", admin_memberships_path, class: "text-gray-600 hover:text-gray-800" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <dt class="text-sm font-medium text-gray-500">Member</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= @membership.payer_name %></dd>
        <dd class="text-sm text-gray-500"><%= @membership.user.email_address %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Type</dt>
        <dd class="mt-1">
          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= @membership.full? ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' %>">
            <%= @membership.membership_type.humanize %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Started</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= @membership.starts_on.strftime("%d %b %Y") %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Paid until</dt>
        <dd class="mt-1 text-lg text-gray-900"><%= @membership.expires_on&.strftime("%d %b %Y") || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Payment</dt>
        <dd class="mt-1"><%= payment_status_badge(@membership) %></dd>
      </div>
      <% if @membership.notes.present? %>
        <div class="md:col-span-2">
          <dt class="text-sm font-medium text-gray-500">Notes</dt>
          <dd class="mt-1 text-gray-900"><%= @membership.notes %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <!-- Payments Section -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-bold mb-1">Payment History</h2>
    <p class="text-sm text-gray-500 mb-4">Deleting a payment removes the record only. It does not change the paid until date.</p>

    <% if @membership.payments.any? %>
      <table class="min-w-full divide-y divide-gray-200 mb-6">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Method</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Notes</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @membership.payments.order(paid_on: :desc).each do |payment| %>
            <tr>
              <td class="px-4 py-2 text-sm text-gray-900"><%= payment.paid_on.strftime("%d %b %Y") %></td>
              <td class="px-4 py-2 text-sm text-gray-900">&euro;<%= sprintf("%.2f", payment.amount_euro) %></td>
              <td class="px-4 py-2 text-sm text-gray-500"><%= payment.payment_method.humanize %></td>
              <td class="px-4 py-2 text-sm text-gray-900"><%= payment.description %></td>
              <td class="px-4 py-2 text-sm text-gray-500"><%= payment.notes %></td>
              <td class="px-4 py-2 text-sm">
                <%= button_to "Delete", admin_membership_payment_path(@membership, payment), method: :delete, class: "text-red-600 hover:text-red-900", data: { turbo_confirm: "Delete this payment?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-gray-500 mb-6">No payments recorded.</p>
    <% end %>

    <!-- Add Payment Form -->
    <% fee_cents = Membership::FEE_CENTS[@membership.membership_type.to_sym] %>
    <h3 class="text-lg font-medium mb-1">Record Payment</h3>
    <p class="text-sm text-gray-500 mb-3">A payment for the membership fee renews the membership to the end of the year. Use the date the money arrived. Put a bank reference in Notes.</p>
    <%= form_with model: Payment.new, url: admin_membership_payments_path(@membership), class: "space-y-4" do |form| %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= form.label :amount_euro, "Amount (€)", class: "block text-sm font-medium text-gray-700" %>
          <%= form.number_field :amount_euro, required: true, step: "0.01", min: "0.01", value: fee_cents && number_with_precision(fee_cents / 100.0, precision: 2), class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500", placeholder: "20.00" %>
        </div>
        <div>
          <%= form.label :paid_on, "Date", class: "block text-sm font-medium text-gray-700" %>
          <%= form.date_field :paid_on, required: true, value: Date.current, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
        </div>
        <div>
          <%= form.label :payment_method, "Method", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :payment_method, Payment.payment_methods.keys.map { |m| [m.humanize, m] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= form.label :purpose, "Purpose", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :purpose, Payment.purposes.keys.map { |p| [p.humanize.sub("Other purpose", "Other"), p] }, { selected: "membership" }, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
        </div>
        <div>
          <%= form.label :description, "Description (required)", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :description, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500", placeholder: "e.g. Annual membership fee, Space hire" %>
        </div>
        <div>
          <%= form.label :notes, "Notes (optional)", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :notes, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
        </div>
      </div>
      <%= form.submit "Record Payment", class: "bg-pink-600 text-white px-4 py-2 rounded hover:bg-pink-700 cursor-pointer" %>
    <% end %>
  </div>

  <div class="mt-6">
    <%= button_to "Delete Membership", admin_membership_path(@membership), method: :delete, class: "text-red-600 hover:text-red-900", data: { turbo_confirm: "Are you sure you want to delete this membership?" } %>
  </div>
</div>
