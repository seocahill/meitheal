<%= form_with model: [:admin, membership], class: "space-y-6" do |form| %>
  <% if membership.errors.any? %>
    <div class="form-error">
      <h2><%= pluralize(membership.errors.count, "error") %> prohibited this membership from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% membership.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, "Member", class: "form-label" %>
    <%= form.collection_select :user_id, @users, :id, :email_address, { prompt: "Select a member" }, class: "form-input" %>
  </div>

  <div>
    <%= form.label :membership_type, "Type", class: "form-label" %>
    <%= form.select :membership_type, Membership.membership_types.keys.map { |t| [t.humanize, t] }, {}, class: "form-input" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :starts_on, "Start Date", class: "form-label" %>
      <%= form.date_field :starts_on, value: membership.starts_on || Date.current, class: "form-input" %>
    </div>

    <div>
      <%= form.label :expires_on, "Expiry Date (optional)", class: "form-label" %>
      <%= form.date_field :expires_on, class: "form-input" %>
    </div>
  </div>

  <div>
    <%= form.label :notes, "Notes (optional)", class: "form-label" %>
    <%= form.text_area :notes, rows: 3, class: "form-input" %>
  </div>

  <div class="flex items-center justify-end gap-4 pt-4 border-t border-gray-100">
    <%= link_to "Cancel", admin_memberships_path, class: "text-gray-600 hover:text-gray-900" %>
    <%= form.submit class: "btn-primary text-white px-6 py-2.5 rounded-xl font-medium cursor-pointer" %>
  </div>
<% end %>
