<%= form_with model: [:admin, membership], class: "space-y-6" do |form| %>
  <% if membership.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <h2 class="font-bold"><%= pluralize(membership.errors.count, "error") %> prohibited this membership from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% membership.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, "Member", class: "block text-sm font-medium text-gray-700" %>
    <%= form.collection_select :user_id, @users, :id, :email_address, { prompt: "Select a member" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div>
    <%= form.label :membership_type, "Type", class: "block text-sm font-medium text-gray-700" %>
    <%= form.select :membership_type, Membership.membership_types.keys.map { |t| [t.humanize, t] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :starts_on, "Start Date", class: "block text-sm font-medium text-gray-700" %>
      <%= form.date_field :starts_on, value: membership.starts_on || Date.current, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
    </div>

    <div>
      <%= form.label :expires_on, "Expiry Date (optional)", class: "block text-sm font-medium text-gray-700" %>
      <%= form.date_field :expires_on, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
    </div>
  </div>

  <div>
    <%= form.label :notes, "Notes (optional)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :notes, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div class="flex items-center justify-end gap-4">
    <%= link_to "Cancel", admin_memberships_path, class: "text-gray-600 hover:text-gray-800" %>
    <%= form.submit class: "bg-pink-600 text-white px-6 py-2 rounded hover:bg-pink-700 cursor-pointer" %>
  </div>
<% end %>
