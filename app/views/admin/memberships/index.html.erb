<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold">Memberships</h1>
    </div>
    <div class="flex items-center gap-3">
      <%= form_with url: admin_memberships_path, method: :get, local: true do |f| %>
        <div class="relative">
          <input
            type="text"
            name="q"
            value="<%= params[:q] %>"
            placeholder="Search by email..."
            class="w-64 pl-3 pr-10 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
          >
          <% if params[:status].present? %>
            <input type="hidden" name="status" value="<%= params[:status] %>">
          <% end %>
          <button type="submit" class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"></path>
            </svg>
          </button>
        </div>
      <% end %>
      <%= link_to "New Membership", new_admin_membership_path, class: "bg-pink-600 text-white px-4 py-2 rounded hover:bg-pink-700 text-sm" %>
    </div>
  </div>

  <!-- Status filter -->
  <div class="flex gap-2 mb-4">
    <%= link_to "All", admin_memberships_path(q: params[:q].presence),
          class: "px-3 py-1 rounded-full text-sm border #{params[:status].blank? ? 'bg-gray-800 text-white border-gray-800' : 'border-gray-300 text-gray-600 hover:bg-gray-50'}" %>
    <%= link_to "Active", admin_memberships_path(status: "active", q: params[:q].presence),
          class: "px-3 py-1 rounded-full text-sm border #{params[:status] == 'active' ? 'bg-green-600 text-white border-green-600' : 'border-gray-300 text-gray-600 hover:bg-gray-50'}" %>
    <%= link_to "Expired", admin_memberships_path(status: "expired", q: params[:q].presence),
          class: "px-3 py-1 rounded-full text-sm border #{params[:status] == 'expired' ? 'bg-red-600 text-white border-red-600' : 'border-gray-300 text-gray-600 hover:bg-gray-50'}" %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Member</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Started</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expires</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @memberships.each do |membership| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-gray-900"><%= membership.user.email_address %></div>
              <div class="text-sm font-medium text-gray-900"><%= membership.user.name %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= membership.full? ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' %>">
                <%= membership.membership_type.humanize %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= membership.starts_on.strftime("%d %b %Y") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= membership.expires_on&.strftime("%d %b %Y") || "Never" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if membership.expired? %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Expired</span>
              <% else %>
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Active</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <%= link_to "View", admin_membership_path(membership), class: "text-pink-600 hover:text-pink-900 mr-4" %>
              <%= link_to "Edit", edit_admin_membership_path(membership), class: "text-gray-600 hover:text-gray-900" %>
            </td>
          </tr>
        <% end %>
        <% if @memberships.empty? %>
          <tr>
            <td colspan="6" class="px-6 py-12 text-center text-gray-500">No memberships found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @page > 1 || @has_more %>
    <div class="mt-4 flex items-center justify-between text-sm text-gray-600">
      <div>Page <%= @page %></div>
      <div class="flex gap-2">
        <% if @page > 1 %>
          <%= link_to "Previous",
                admin_memberships_path(q: params[:q].presence, status: params[:status].presence, page: @page - 1),
                class: "px-3 py-1 border border-gray-300 rounded-lg hover:bg-gray-50" %>
        <% end %>
        <% if @has_more %>
          <%= link_to "Next",
                admin_memberships_path(q: params[:q].presence, status: params[:status].presence, page: @page + 1),
                class: "px-3 py-1 border border-gray-300 rounded-lg hover:bg-gray-50" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
