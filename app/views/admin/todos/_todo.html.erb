<div id="<%= dom_id(todo) %>" class="flex items-start gap-4 px-4 py-3 hover:bg-gray-50 transition-colors <%= 'opacity-60' if todo.completed? %>">
  <div class="flex items-center pt-0.5">
    <input type="checkbox"
           form="todo-batch"
           name="todo_ids[]"
           value="<%= todo.id %>"
           data-batch-select-target="checkbox"
           data-action="change->batch-select#toggle"
           class="form-checkbox w-4 h-4 text-purple-600 rounded">
  </div>

  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2">
      <% if todo.completed? %>
        <span class="line-through text-gray-500"><%= todo.title %></span>
      <% else %>
        <span class="font-medium text-gray-900"><%= todo.title %></span>
      <% end %>

      <% case todo.priority %>
      <% when "urgent" %>
        <span class="px-1.5 py-0.5 text-xs font-medium bg-rose-100 text-rose-700 rounded">Urgent</span>
      <% when "high" %>
        <span class="px-1.5 py-0.5 text-xs font-medium bg-amber-100 text-amber-700 rounded">High</span>
      <% end %>

      <% if todo.overdue? %>
        <span class="px-1.5 py-0.5 text-xs font-medium bg-rose-100 text-rose-700 rounded">Overdue</span>
      <% elsif todo.due_soon? %>
        <span class="px-1.5 py-0.5 text-xs font-medium bg-amber-100 text-amber-700 rounded">Due soon</span>
      <% end %>
    </div>

    <% if todo.description.present? %>
      <p class="text-sm text-gray-600 mt-0.5 line-clamp-1"><%= todo.description %></p>
    <% end %>

    <% if todo.due_date.present? || todo.source.present? %>
      <div class="flex items-center gap-3 mt-1 text-xs text-gray-500">
        <% if todo.due_date.present? %>
          <span class="<%= 'text-rose-600' if todo.overdue? %>">
            Due <%= todo.due_date.strftime("%b %d") %>
          </span>
        <% end %>
        <% if todo.source.present? %>
          <span>From: <%= todo.source_type.underscore.humanize %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flex items-center gap-2">
    <%= button_to toggle_admin_todo_path(todo), method: :patch, class: "p-1.5 rounded-lg hover:bg-gray-100 transition-colors", title: todo.completed? ? "Mark incomplete" : "Mark complete" do %>
      <% if todo.completed? %>
        <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      <% else %>
        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="9" stroke-width="2"/>
        </svg>
      <% end %>
    <% end %>

    <%= link_to edit_admin_todo_path(todo), class: "p-1.5 rounded-lg hover:bg-gray-100 transition-colors text-gray-400 hover:text-gray-600" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
      </svg>
    <% end %>
  </div>
</div>
