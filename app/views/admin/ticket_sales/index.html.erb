<% content_for :title, "Ticket Sales" %>

<div class="max-w-4xl mx-auto px-6">
  <h1 class="text-2xl font-bold mb-6">Ticket Sales</h1>

  <div class="bg-white shadow rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden sm:table-cell">Date</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Sold</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Revenue</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @events.each do |event| %>
          <tr onclick="window.location='<%= admin_ticket_sale_path(event) %>'" class="hover:bg-gray-50 cursor-pointer">
            <td class="px-4 py-3 font-medium text-gray-900"><%= event.title %></td>
            <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap hidden sm:table-cell"><%= event.starts_at.strftime("%d %b %Y") %></td>
            <td class="px-4 py-3 text-sm text-right text-gray-900"><%= event.tickets_sold %></td>
            <td class="px-4 py-3 text-sm text-right text-gray-900">&euro;<%= number_with_precision(event.tickets.paid.sum(:amount_cents) / 100.0, precision: 2) %></td>
          </tr>
        <% end %>
        <% if @events.empty? %>
          <tr>
            <td colspan="5" class="px-6 py-12 text-center text-gray-400">No ticket sales yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
