<% content_for :title, "Ticket Sales — #{@event.title}" %>

<div class="max-w-4xl mx-auto px-6">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← All events", admin_ticket_sales_path, class: "text-sm text-gray-400 hover:text-gray-600" %>
  </div>

  <div class="flex items-baseline gap-3 mb-1">
    <h1 class="text-2xl font-bold"><%= @event.title %></h1>
    <%= link_to "View event →", event_path(@event), class: "text-sm text-purple-600 hover:text-purple-800" %>
  </div>
  <p class="text-sm text-gray-500 mb-6"><%= @event.starts_at.strftime("%A %d %B %Y") %></p>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-lg border border-gray-200 px-4 py-3">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Tickets sold</p>
      <p class="text-2xl font-bold text-gray-900"><%= @paid_count %></p>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 px-4 py-3">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Reserved</p>
      <p class="text-2xl font-bold text-gray-900"><%= @reserved_count %></p>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 px-4 py-3">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Revenue</p>
      <p class="text-2xl font-bold text-gray-900">&euro;<%= number_with_precision(@total_cents / 100.0, precision: 2) %></p>
    </div>
    <% if @event.capacity.present? %>
    <div class="bg-white rounded-lg border border-gray-200 px-4 py-3">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Remaining</p>
      <p class="text-2xl font-bold text-gray-900"><%= @event.tickets_remaining %></p>
    </div>
    <% end %>
  </div>

  <div class="bg-white shadow rounded-lg p-4 mb-8">
    <h2 class="text-sm font-semibold text-gray-900 mb-1">Add a booking</h2>
    <p class="text-xs text-gray-500 mb-4">For people paying at the door. This holds a seat and reduces the tickets available online.</p>
    <%= form_with url: add_booking_admin_ticket_sale_path(@event), method: :post, class: "flex flex-wrap items-end gap-3" do %>
      <div>
        <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Name</label>
        <%= text_field_tag :buyer_name, nil, required: true, class: "border border-gray-300 rounded px-3 py-2 text-sm" %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Email <span class="text-gray-400 normal-case">(optional)</span></label>
        <%= email_field_tag :buyer_email, nil, class: "border border-gray-300 rounded px-3 py-2 text-sm" %>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Qty</label>
        <%= number_field_tag :quantity, 1, min: 1, class: "border border-gray-300 rounded px-3 py-2 text-sm w-20" %>
      </div>
      <%= submit_tag "Add booking", class: "px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700 text-sm cursor-pointer" %>
    <% end %>
  </div>

  <div class="bg-white shadow rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Qty</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
          <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @tickets.each do |ticket| %>
          <tr>
            <td class="px-4 py-3 font-medium text-gray-900"><%= ticket.buyer_name %></td>
            <td class="px-4 py-3 text-sm text-gray-600"><%= ticket.buyer_email %></td>
            <td class="px-4 py-3 text-center text-sm text-gray-700"><%= ticket.quantity %></td>
            <td class="px-4 py-3 text-right text-sm text-gray-700">&euro;<%= number_with_precision(ticket.amount_cents / 100.0, precision: 2) %></td>
            <td class="px-4 py-3 text-center">
              <% case ticket.status %>
              <% when "paid" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Paid</span>
              <% when "reserved" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Reserved</span>
              <% when "pending" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800" title="Started checkout but did not complete payment">Incomplete</span>
              <% when "failed" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Failed</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right text-sm text-gray-500 whitespace-nowrap"><%= ticket.created_at.strftime("%-d %b %Y") %></td>
          </tr>
        <% end %>
        <% if @tickets.empty? %>
          <tr>
            <td colspan="6" class="px-6 py-12 text-center text-gray-400">No tickets yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
