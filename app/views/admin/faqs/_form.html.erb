<%= form_with model: [ :admin, faq ], local: true, class: "space-y-6" do |f| %>
  <% if faq.errors.any? %>
    <div class="form-error">
      <h3><%= pluralize(faq.errors.count, "error") %> prohibited this FAQ from being saved:</h3>
      <ul class="mt-2 list-disc list-inside">
        <% faq.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :question, class: "form-label" %>
    <%= f.text_field :question, class: "form-input", placeholder: "What is your question?" %>
  </div>

  <div>
    <%= f.label :answer, class: "form-label" %>
    <%= f.rich_text_area :answer, class: "form-input" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :order, class: "form-label" %>
      <%= f.number_field :order, class: "form-input", placeholder: "10, 20, 30..." %>
      <p class="form-hint">Lower numbers appear first</p>
    </div>

    <div class="flex items-center pt-6">
      <%= f.check_box :active, class: "form-checkbox mr-2" %>
      <%= f.label :active, "Active (visible on public FAQ page)", class: "text-sm text-gray-700" %>
    </div>
  </div>

  <div class="flex items-center gap-3 pt-4">
    <%= f.submit class: "btn-primary text-white px-5 py-2.5 rounded-xl font-medium cursor-pointer" %>
    <%= link_to "Cancel", admin_faqs_path, class: "btn-secondary" %>
  </div>
<% end %>
