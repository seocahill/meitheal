<div class="max-w-6xl mx-auto px-4 sm:px-6">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">FAQs</h1>
    <%= link_to "New FAQ", new_admin_faq_path, class: "btn-primary text-white px-5 py-2.5 rounded-xl font-medium" %>
  </div>

  <% if @faqs.empty? %>
    <div class="card p-12 text-center">
      <p class="text-gray-500 text-lg">No FAQs yet.</p>
      <p class="mt-4">
        <%= link_to "Create the first FAQ", new_admin_faq_path, class: "link-accent font-medium" %>
      </p>
    </div>
  <% else %>
    <div class="space-y-4">
      <% @faqs.each do |faq| %>
        <div class="card p-6">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-gray-900 mb-2">
                <%= faq.question %>
              </h3>
              <% if faq.answer.present? %>
                <div class="text-gray-600 text-sm line-clamp-2">
                  <%= faq.answer.to_plain_text.truncate(200) %>
                </div>
              <% end %>
              <div class="mt-3 flex items-center gap-4 text-sm">
                <span class="text-gray-500">Order: <%= faq.order || "—" %></span>
                <span class="<%= faq.active? ? 'text-green-600' : 'text-gray-400' %>">
                  <%= faq.active? ? "Active" : "Inactive" %>
                </span>
              </div>
            </div>
            <div class="flex items-center gap-2 ml-4">
              <%= button_to "↑", move_up_admin_faq_path(faq), method: :patch, class: "px-3 py-1 text-gray-600 hover:text-gray-900 border border-gray-300 rounded" %>
              <%= button_to "↓", move_down_admin_faq_path(faq), method: :patch, class: "px-3 py-1 text-gray-600 hover:text-gray-900 border border-gray-300 rounded" %>
              <%= link_to "Edit", edit_admin_faq_path(faq), class: "px-3 py-1 text-purple-600 hover:text-purple-800 border border-purple-300 rounded" %>
              <%= button_to "Delete", admin_faq_path(faq), method: :delete, data: { confirm: "Are you sure?" }, class: "px-3 py-1 text-red-600 hover:text-red-800 border border-red-300 rounded" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
