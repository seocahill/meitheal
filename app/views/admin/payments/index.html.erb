<% method_tabs = [
  [ nil, "All", "bg-purple-100 text-purple-700" ],
  [ "cash", "Cash", "bg-green-100 text-green-700" ],
  [ "bank_transfer", "Bank Transfer", "bg-blue-100 text-blue-700" ],
  [ "sumup", "SumUp", "bg-purple-100 text-purple-700" ],
  [ "other", "Other", "bg-gray-200 text-gray-700" ]
] %>
<% field = "border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Manage Payments</h1>
  </div>

  <!-- Total for the current filters -->
  <div class="bg-white shadow rounded-lg px-5 py-4 mb-6 flex flex-wrap items-center gap-x-8 gap-y-2">
    <div>
      <div class="text-xs font-medium text-gray-500 uppercase tracking-wider">Collected</div>
      <div class="text-2xl font-bold text-gray-900" data-total>&euro;<%= number_with_precision(@total_cents / 100.0, precision: 2, delimiter: ",") %></div>
      <div class="text-xs text-gray-500" data-total-count><%= pluralize(@completed_count, "completed payment") %>, pending and failed not counted</div>
    </div>
    <% @method_totals_cents.sort_by { |_, cents| -cents }.each do |method, cents| %>
      <div data-method-total="<%= method %>">
        <div class="text-xs font-medium text-gray-500"><%= method.humanize %></div>
        <div class="text-lg font-semibold text-gray-900">&euro;<%= number_with_precision(cents / 100.0, precision: 2, delimiter: ",") %></div>
      </div>
    <% end %>
  </div>

  <!-- Method tabs -->
  <div class="flex flex-wrap gap-2 mb-4">
    <% method_tabs.each do |value, label, active_class| %>
      <%= link_to label, list_path(payment_method: value),
            class: "px-4 py-2 rounded-lg text-sm font-medium #{params[:payment_method].presence == value ? active_class : 'text-gray-600 hover:bg-gray-100'}" %>
    <% end %>
  </div>

  <!-- Search, purpose, status and dates -->
  <%= form_with url: admin_payments_path, method: :get, class: "mb-6 space-y-4" do |form| %>
    <%= hidden_filter_fields(:payment_method) %>
    <%= render "admin/shared/date_range_filter", filter: @date_filter, label: "Paid" %>
    <div class="flex flex-wrap items-end gap-3">
      <div class="flex-1 min-w-[200px]">
        <label for="search" class="block text-xs font-medium text-gray-500 mb-1">Search</label>
        <%= form.text_field :search, value: params[:search], placeholder: "Name, email or description", class: "#{field} w-full" %>
      </div>
      <div>
        <label for="purpose" class="block text-xs font-medium text-gray-500 mb-1">Purpose</label>
        <%= form.select :purpose, Payment.purposes.keys.map { |p| [ p.humanize.sub("Other purpose", "Other"), p ] }, { include_blank: "All", selected: params[:purpose] }, class: field %>
      </div>
      <div>
        <label for="status" class="block text-xs font-medium text-gray-500 mb-1">Status</label>
        <%= form.select :status, Payment.statuses.keys.map { |s| [ s.humanize, s ] }, { include_blank: "All", selected: params[:status] }, class: field %>
      </div>
      <%= form.submit "Apply", name: nil, class: "bg-pink-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-pink-700 cursor-pointer" %>
      <% if list_filters.present? %>
        <%= link_to "Clear", admin_payments_path, class: "text-sm text-gray-500 hover:text-gray-700 py-2" %>
      <% end %>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Purpose</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Method</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @payments.any? %>
          <% @payments.each do |payment| %>
            <tr>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                <%= payment.paid_on.strftime("%d %b %Y") %>
              </td>
              <td class="px-4 py-3 text-sm">
                <div class="font-medium text-gray-900"><%= payment.user_name %></div>
                <div class="text-gray-500 text-xs"><%= payment.user_email %></div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                  <%= payment.purpose&.humanize&.sub("Other purpose", "Other") %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-900">
                <%= truncate(payment.description, length: 60) %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900">
                &euro;<%= number_with_precision(payment.amount_euro, precision: 2) %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% badge_class = case payment.payment_method
                   when 'cash' then 'bg-green-100 text-green-800'
                   when 'bank_transfer' then 'bg-blue-100 text-blue-800'
                   when 'sumup' then 'bg-purple-100 text-purple-800'
                   else 'bg-gray-100 text-gray-800'
                   end %>
                <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium <%= badge_class %>">
                  <%= payment.payment_method.humanize %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% status_class = case payment.status
                   when 'completed' then 'bg-green-100 text-green-800'
                   when 'pending' then 'bg-yellow-100 text-yellow-800'
                   when 'failed' then 'bg-red-100 text-red-800'
                   end %>
                <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_class %>">
                  <%= payment.status.humanize %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-right text-sm">
                <%= link_to "View Member", admin_membership_path(payment.membership), class: "px-3 py-1.5 rounded text-xs font-medium text-white bg-purple-600 hover:bg-purple-700 transition-colors" %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8" class="px-6 py-12 text-center text-gray-500">
              No payments found matching the selected filters.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <nav class="mt-8 text-center text-sm">
    <%== @pagy.series_nav %>
  </nav>
</div>
