<div class="max-w-4xl mx-auto px-4">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Edit Page</h1>

  <%= render "form", page: @page %>

  <div class="mt-8 pt-6 border-t border-gray-200">
    <%= button_to "Delete Page", admin_page_path(@page), method: :delete, class: "text-red-600 hover:text-red-800", data: { turbo_confirm: "Are you sure you want to delete this page?" } %>
  </div>
</div>
