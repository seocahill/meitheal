<%= form_with model: [:admin, page], class: "space-y-6" do |form| %>
  <% if page.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <h2 class="font-bold"><%= pluralize(page.errors.count, "error") %> prohibited this page from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% page.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div>
    <%= form.label :slug, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :slug, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500", placeholder: "e.g. about-us" %>
    <p class="mt-1 text-sm text-gray-500">URL path for the page (lowercase letters, numbers, and hyphens only)</p>
  </div>

  <div>
    <%= form.label :content, class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.rich_text_area :content, class: "mt-1 block w-full" %>
  </div>

  <div class="flex items-center">
    <%= form.check_box :published, class: "h-4 w-4 text-pink-600 focus:ring-pink-500 border-gray-300 rounded" %>
    <%= form.label :published, "Publish this page", class: "ml-2 block text-sm text-gray-900" %>
  </div>

  <div class="flex items-center justify-end gap-4">
    <%= link_to "Cancel", admin_pages_path, class: "text-gray-600 hover:text-gray-800" %>
    <%= form.submit class: "bg-pink-600 text-white px-6 py-2 rounded hover:bg-pink-700 cursor-pointer" %>
  </div>
<% end %>
