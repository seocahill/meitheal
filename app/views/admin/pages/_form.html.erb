<%= form_with model: [:admin, page], class: "space-y-6" do |form| %>
  <% if page.errors.any? %>
    <div class="form-error">
      <h2><%= pluralize(page.errors.count, "error") %> prohibited this page from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% page.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-input" %>
  </div>

  <div>
    <%= form.label :slug, class: "form-label" %>
    <%= form.text_field :slug, class: "form-input", placeholder: "e.g. about-us" %>
    <p class="form-hint">URL path for the page (lowercase letters, numbers, and hyphens only)</p>
  </div>

  <div>
    <%= form.label :content, class: "form-label mb-2" %>
    <%= form.rich_text_area :content %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.check_box :published, class: "form-checkbox" %>
    <%= form.label :published, "Publish this page", class: "text-sm text-gray-700" %>
  </div>

  <div class="flex items-center justify-end gap-4 pt-4 border-t border-gray-100">
    <%= link_to "Cancel", admin_pages_path, class: "text-gray-600 hover:text-gray-900" %>
    <%= form.submit class: "btn-primary text-white px-6 py-2.5 rounded-xl font-medium cursor-pointer" %>
  </div>
<% end %>
