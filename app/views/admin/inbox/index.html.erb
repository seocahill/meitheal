<div class="max-w-6xl mx-auto px-4 sm:px-6">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Inbox</h1>
  </div>

  <% if @config_error %>
    <div class="card p-8 text-center">
      <div class="text-amber-600 mb-4">
        <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
      </div>
      <p class="text-gray-700 font-medium mb-2">Configuration Required</p>
      <p class="text-gray-500 text-sm"><%= @config_error %></p>
    </div>
  <% elsif @auth_error %>
    <div class="card p-8 text-center">
      <div class="text-rose-600 mb-4">
        <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
      </div>
      <p class="text-gray-700 font-medium mb-2">Authentication Error</p>
      <p class="text-gray-500 text-sm"><%= @auth_error %></p>
    </div>
  <% elsif @api_error %>
    <div class="card p-8 text-center">
      <div class="text-rose-600 mb-4">
        <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <p class="text-gray-700 font-medium mb-2">API Error</p>
      <p class="text-gray-500 text-sm"><%= @api_error %></p>
    </div>
  <% else %>
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      <!-- Folders sidebar -->
      <div class="lg:col-span-1">
        <div class="card p-4">
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Folders</h2>
          <nav class="space-y-1">
            <% @folders&.each do |folder| %>
              <%= link_to admin_inbox_index_path(folder_id: folder["folderId"]),
                  class: "flex items-center justify-between px-3 py-2 rounded-lg text-sm #{folder['folderId'].to_s == @current_folder.to_s ? 'bg-purple-50 text-purple-700 font-medium' : 'text-gray-700 hover:bg-gray-50'}" do %>
                <span><%= folder["folderName"] %></span>
                <% if folder["unReadCount"].to_i > 0 %>
                  <span class="bg-purple-100 text-purple-700 text-xs font-medium px-2 py-0.5 rounded-full">
                    <%= folder["unReadCount"] %>
                  </span>
                <% end %>
              <% end %>
            <% end %>
          </nav>
        </div>
      </div>

      <!-- Email list -->
      <div class="lg:col-span-3">
        <div class="card divide-y divide-gray-100">
          <% if @emails.blank? %>
            <div class="p-8 text-center">
              <p class="text-gray-500">No emails in this folder.</p>
            </div>
          <% else %>
            <% @emails.each do |email| %>
              <%= link_to admin_inbox_path(email["messageId"], folder_id: @current_folder),
                  class: "block px-4 py-4 hover:bg-gray-50 transition-colors #{email['isUnread'] ? 'bg-purple-50/30' : ''}" do %>
                <div class="flex items-start gap-4">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <% if email["isUnread"] %>
                        <span class="w-2 h-2 bg-purple-500 rounded-full flex-shrink-0"></span>
                      <% end %>
                      <p class="text-sm font-medium text-gray-900 truncate <%= 'font-semibold' if email['isUnread'] %>">
                        <%= email["fromAddress"] || email["sender"] %>
                      </p>
                    </div>
                    <p class="text-sm text-gray-900 truncate <%= 'font-medium' if email['isUnread'] %>">
                      <%= email["subject"] || "(No subject)" %>
                    </p>
                    <p class="text-sm text-gray-500 truncate mt-1">
                      <%= email["summary"] || email["snippet"] %>
                    </p>
                  </div>
                  <div class="flex-shrink-0 text-right">
                    <p class="text-xs text-gray-500">
                      <%= format_zoho_time(email["receivedTime"]) %>
                    </p>
                    <% if email["hasAttachment"] %>
                      <svg class="w-4 h-4 text-gray-400 mt-1 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
                      </svg>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>

            <!-- Pagination -->
            <% if @page > 1 || @has_more %>
              <div class="px-4 py-3 flex items-center justify-between">
                <div class="text-sm text-gray-500">
                  Page <%= @page %>
                </div>
                <div class="flex gap-2">
                  <% if @page > 1 %>
                    <%= link_to "Previous", admin_inbox_index_path(folder_id: @current_folder, page: @page - 1), class: "px-3 py-1 text-sm border border-gray-300 rounded-lg hover:bg-gray-50" %>
                  <% end %>
                  <% if @has_more %>
                    <%= link_to "Next", admin_inbox_index_path(folder_id: @current_folder, page: @page + 1), class: "px-3 py-1 text-sm border border-gray-300 rounded-lg hover:bg-gray-50" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
