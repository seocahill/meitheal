<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-2">Groups</h1>
  <p class="text-sm text-gray-500 mb-8">Members grouped by the interests set for them. Tap a group to see and manage its members.</p>

  <% if @groups.empty? %>
    <p class="text-gray-500">No interests have been set yet.</p>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @groups.each do |interest, profiles| %>
        <%= link_to admin_users_path(interest: interest), class: "block bg-white shadow rounded-lg p-4 hover:shadow-md" do %>
          <div class="flex items-baseline justify-between gap-3">
            <span class="font-semibold text-gray-900 break-words"><%= interest %></span>
            <span class="text-sm text-gray-500 whitespace-nowrap"><%= pluralize(profiles.size, "member") %></span>
          </div>
          <p class="mt-2 text-sm text-gray-600">
            <%= profiles.first(4).map(&:name).to_sentence(two_words_connector: ", ", last_word_connector: ", ") %><% if profiles.size > 4 %> + <%= profiles.size - 4 %> more<% end %>
          </p>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
