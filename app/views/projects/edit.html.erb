<div class="max-w-4xl mx-auto px-4 sm:px-6">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Edit Project</h1>

  <div class="card p-6">
    <%= render "form", post: @post %>
  </div>

  <div class="card p-6 mt-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Danger Zone</h2>
    <%= button_to "Delete Project", project_path(@post.slug), method: :delete, class: "text-rose-600 hover:text-rose-800 font-medium", data: { turbo_confirm: "Are you sure you want to delete this project?" } %>
  </div>
</div>
