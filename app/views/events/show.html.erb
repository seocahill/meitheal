<div class="max-w-2xl mx-auto px-4 py-8">
  <% unless @event.published? %>
    <div class="bg-yellow-100 border border-yellow-400 text-yellow-800 px-4 py-3 rounded mb-6">
      <%= t("event_draft_notice") %>
    </div>
  <% end %>

  <article class="prose prose-lg max-w-none">
    <h1 class="text-3xl font-bold mb-6"><%= @event.title %></h1>

    <% if @event.image.attached? %>
      <%= image_tag @event.image, alt: @event.title, class: "w-full mb-8 not-prose" %>
    <% end %>

    <p class="font-semibold text-gray-800">
      <%= @event.starts_at.strftime("%A %d %B") %>
      <% if @event.doors_at.present? %>
        / Doors: <%= @event.doors_at.strftime("%-l:%M%P") %>
      <% end %>
      <% if @event.starts_at.present? %>
        / Start: <%= @event.starts_at.strftime("%-l:%M%P") %>
      <% end %>
    </p>

    <% if @event.description.present? || @event.rich_description.present? %>
      <div class="mt-6">
        <%= @event.rendered_description %>
      </div>
    <% end %>

    <% if @event.bio.present? %>
      <div class="mt-6">
        <%= simple_format(@event.bio) %>
      </div>
    <% end %>

    <% if @event.links.present? %>
      <div class="mt-6">
        <%= simple_format(@event.links) %>
      </div>
    <% end %>

    <% if @event.ticketing_enabled? || @event.ticket_url.present? %>
      <div class="mt-8 not-prose">
        <% if @event.ticketing_enabled? %>
          <% scarcity_label = @event.capacity.present? ? @event.ticket_availability_label : nil %>
          <% if @event.sold_out? %>
            <span class="block w-full text-center px-6 py-3 bg-gray-100 text-gray-500 rounded-xl font-medium text-sm cursor-not-allowed"><%= t("sold_out") %></span>
          <% elsif @event.tickets_available_from.present? && @event.tickets_available_from > Time.current %>
            <p class="text-sm text-gray-500"><%= t("on_sale_from") %> <strong class="text-gray-700"><%= @event.tickets_available_from.strftime("%A %d %B at %-l:%M%P") %></strong></p>
          <% else %>
            <%= link_to t("get_tickets"), new_event_tickets_path(@event), class: "block w-full text-center px-6 py-3 btn-primary rounded-xl font-semibold text-sm", style: "color: white;" %>
            <% if scarcity_label && scarcity_label != "Tickets still available" %>
              <p class="text-center text-xs text-orange-600 font-medium mt-2"><%= scarcity_label %></p>
            <% end %>
          <% end %>
        <% elsif @event.ticket_url.present? %>
          <%= link_to t("get_tickets"), @event.ticket_url, class: "block w-full text-center px-6 py-3 btn-primary rounded-xl font-semibold text-sm", style: "color: white;", target: "_blank", rel: "noopener" %>
        <% end %>
      </div>
    <% end %>
  </article>

  <% if @event.qr_code.attached? %>
    <div class="mt-10 pt-8 border-t border-gray-200 not-prose print:mt-4">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3"><%= t("share_this_event") %></p>
      <div class="flex items-start gap-4">
        <%= image_tag @event.qr_code, alt: "QR code for #{@event.title}", class: "w-28 h-28", width: 112, height: 112 %>
        <div class="text-sm text-gray-600 self-center">
          <p><%= t("scan_for_event") %></p>
          <p class="mt-1 font-mono text-xs text-gray-400 break-all"><%= event_url(@event) %></p>
        </div>
      </div>
    </div>
  <% end %>

  <% if @event.editable_by?(Current.user) %>
    <div class="flex flex-wrap gap-4 mt-12 pt-8 border-t border-gray-200 print:hidden">
      <%= link_to "Edit", edit_event_path(@event), class: "px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 text-sm" %>
      <% if @event.ticketing_enabled? %>
        <%= link_to "Ticket sales & bookings", admin_ticket_sale_path(@event), class: "px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700 text-sm" %>
      <% end %>
      <% if @event.publishable_by?(Current.user) %>
        <% if @event.published? %>
          <%= button_to "Unpublish", unpublish_event_path(@event), method: :patch, class: "px-4 py-2 bg-yellow-600 text-white rounded hover:bg-yellow-700 text-sm" %>
        <% else %>
          <%= button_to "Publish", publish_event_path(@event), method: :patch, class: "px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm" %>
        <% end %>
      <% end %>
      <%= button_to "Delete", event_path(@event), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 text-sm" %>
    </div>
  <% end %>
</div>
