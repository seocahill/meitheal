<div class="max-w-3xl mx-auto px-4 py-6">
  <% unless @event.published? %>
    <div class="bg-yellow-100 border border-yellow-400 text-yellow-800 px-4 py-3 rounded mb-6">
      <strong>Draft:</strong> This event is not yet published.
    </div>
  <% end %>

  <div class="mb-6">
    <%= link_to "← Back to Events", events_path, class: "text-pink-600 hover:text-pink-800" %>
  </div>

  <article>
    <h1 class="text-3xl font-bold mb-4"><%= @event.title %></h1>

    <p class="text-gray-600 mb-4">
      <time datetime="<%= @event.starts_at.iso8601 %>">
        <%= @event.starts_at.strftime("%A, %B %d, %Y") %>
      </time>
      <% if @event.starts_at.present? %>
        at <%= @event.starts_at.strftime('%l:%M %p') %>
      <% end %>
    </p>

    <% if @event.doors_at.present? %>
      <p class="text-gray-600 mb-4">Doors: <%= @event.doors_at.strftime("%l:%M %p") %></p>
    <% end %>

    <% if @event.image.attached? %>
      <%= image_tag @event.image, alt: @event.title, class: "w-full mb-6" %>
    <% end %>

    <% if @event.description.present? %>
      <div class="prose max-w-none mb-6">
        <%= sanitize(@event.description) %>
      </div>
    <% end %>

    <% if @event.bio.present? %>
      <h2 class="text-2xl font-bold mb-2 mt-6">Bio</h2>
      <div class="mb-6">
        <%= simple_format(@event.bio) %>
      </div>
    <% end %>

    <% if @event.links.present? %>
      <h2 class="text-2xl font-bold mb-2 mt-6">Links</h2>
      <div class="mb-6">
        <%= simple_format(@event.links) %>
      </div>
    <% end %>

    <% if @event.ticket_price_cents.present? || @event.ticket_url.present? || @event.capacity.present? %>
      <div class="bg-gray-50 p-4 my-6">
        <h2 class="text-2xl font-bold mb-3">Booking Info</h2>
        <ul class="space-y-1">
          <% if @event.capacity.present? %>
            <li>Capacity: <%= @event.capacity %> tickets</li>
          <% end %>
          <% if @event.ticket_price_cents.present? %>
            <li>Price: €<%= @event.ticket_price_cents / 100.0 %></li>
          <% end %>
          <% if @event.ticket_url.present? %>
            <li><%= link_to "Buy Tickets", @event.ticket_url, class: "text-pink-600 hover:text-pink-800", target: "_blank" %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @event.venue_name.present? || @event.venue_address.present? %>
      <h2 class="text-2xl font-bold mb-2 mt-6">Location</h2>
      <% if @event.venue_name.present? %>
        <p class="font-semibold"><%= @event.venue_name %></p>
      <% end %>
      <% if @event.venue_address.present? %>
        <%= simple_format(@event.venue_address) %>
      <% end %>
    <% end %>
  </article>

  <% if @event.editable_by?(Current.user) %>
    <div class="flex gap-4 mt-8 pt-8 border-t">
      <%= link_to "Edit", edit_event_path(@event), class: "bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700" %>
      <% if @event.publishable_by?(Current.user) %>
        <% if @event.published? %>
          <%= button_to "Unpublish", unpublish_event_path(@event), method: :patch, class: "bg-yellow-600 text-white px-4 py-2 rounded hover:bg-yellow-700" %>
        <% else %>
          <%= button_to "Publish", publish_event_path(@event), method: :patch, class: "bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
        <% end %>
      <% end %>
      <%= button_to "Delete", event_path(@event), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700" %>
    </div>
  <% end %>
</div>
