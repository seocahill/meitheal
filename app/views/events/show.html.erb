<div class="max-w-2xl mx-auto px-4 py-8">
  <% unless @event.published? %>
    <div class="bg-yellow-100 border border-yellow-400 text-yellow-800 px-4 py-3 rounded mb-6">
      <strong>Draft:</strong> This event is not yet published.
    </div>
  <% end %>

  <article class="prose prose-lg max-w-none">
    <h1 class="text-3xl font-bold mb-6"><%= @event.title %></h1>

    <% if @event.image.attached? %>
      <%= image_tag @event.image, alt: @event.title, class: "w-full mb-8 not-prose" %>
    <% end %>

    <p class="font-semibold text-gray-800">
      <%= @event.starts_at.strftime("%A %B %d") %>
      <% if @event.doors_at.present? %>
        / Doors: <%= @event.doors_at.strftime("%-l.%M%P") %>
      <% end %>
      <% if @event.starts_at.present? %>
        / Start: <%= @event.starts_at.strftime("%-l%P") %>
      <% end %>
    </p>

    <% if @event.description.present? || @event.rich_description.present? %>
      <div class="mt-6">
        <%= @event.rendered_description %>
      </div>
    <% end %>

    <% if @event.bio.present? %>
      <div class="mt-6">
        <%= simple_format(@event.bio) %>
      </div>
    <% end %>

    <% if @event.links.present? %>
      <div class="mt-6">
        <%= simple_format(@event.links) %>
      </div>
    <% end %>

    <% if @event.ticket_price_cents.present? || @event.ticket_url.present? %>
      <div class="mt-8 p-4 bg-gray-50 rounded not-prose">
        <p class="font-semibold text-lg mb-2">Tickets</p>
        <% if @event.ticket_price_cents.present? && @event.ticket_price_cents > 0 %>
          <p class="text-gray-700">Price: €<%= @event.ticket_price_cents / 100.0 %></p>
        <% elsif @event.ticket_price_cents == 0 %>
          <p class="text-gray-700">Free admission</p>
        <% end %>
        <% if @event.ticket_url.present? %>
          <p class="mt-2">
            <%= link_to "Buy Tickets →", @event.ticket_url, class: "underline font-medium", target: "_blank", rel: "noopener" %>
          </p>
        <% end %>
      </div>
    <% end %>

    <% if @event.venue_name.present? || @event.venue_address.present? %>
      <div class="mt-8">
        <p class="font-semibold">Location</p>
        <% if @event.venue_name.present? %>
          <p><%= @event.venue_name %></p>
        <% end %>
        <% if @event.venue_address.present? %>
          <p class="text-gray-600"><%= @event.venue_address %></p>
        <% end %>
      </div>
    <% end %>
  </article>

  <% if @event.editable_by?(Current.user) %>
    <div class="flex flex-wrap gap-4 mt-12 pt-8 border-t border-gray-200">
      <%= link_to "Edit", edit_event_path(@event), class: "px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 text-sm" %>
      <% if @event.publishable_by?(Current.user) %>
        <% if @event.published? %>
          <%= button_to "Unpublish", unpublish_event_path(@event), method: :patch, class: "px-4 py-2 bg-yellow-600 text-white rounded hover:bg-yellow-700 text-sm" %>
        <% else %>
          <%= button_to "Publish", publish_event_path(@event), method: :patch, class: "px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm" %>
        <% end %>
      <% end %>
      <%= button_to "Delete", event_path(@event), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 text-sm" %>
    </div>
  <% end %>
</div>
