<div class="max-w-2xl mx-auto px-4 py-8">
  <% unless @event.published? %>
    <div class="bg-yellow-100 border border-yellow-400 text-yellow-800 px-4 py-3 rounded mb-6">
      <strong>Draft:</strong> This event is not yet published.
    </div>
  <% end %>

  <article class="prose prose-lg max-w-none">
    <h1 class="text-3xl font-bold mb-6"><%= @event.title %></h1>

    <% if @event.image.attached? %>
      <%= image_tag @event.image, alt: @event.title, class: "w-full mb-8 not-prose" %>
    <% end %>

    <p class="font-semibold text-gray-800">
      <%= @event.starts_at.strftime("%A %d %B") %>
      <% if @event.doors_at.present? %>
        / Doors: <%= @event.doors_at.strftime("%-l:%M%P") %>
      <% end %>
      <% if @event.starts_at.present? %>
        / Start: <%= @event.starts_at.strftime("%-l:%M%P") %>
      <% end %>
    </p>

    <% if @event.description.present? || @event.rich_description.present? %>
      <div class="mt-6">
        <%= @event.rendered_description %>
      </div>
    <% end %>

    <% if @event.bio.present? %>
      <div class="mt-6">
        <%= simple_format(@event.bio) %>
      </div>
    <% end %>

    <% if @event.links.present? %>
      <div class="mt-6">
        <%= simple_format(@event.links) %>
      </div>
    <% end %>

    <% if @event.ticketing_enabled? || @event.ticket_url.present? %>
      <div class="mt-8 not-prose">
        <% if @event.ticketing_enabled? %>
          <% scarcity_label = @event.capacity.present? ? @event.ticket_availability_label : nil %>
          <% if @event.sold_out? %>
            <span class="block w-full text-center px-6 py-3 bg-gray-100 text-gray-500 rounded-xl font-medium text-sm cursor-not-allowed">Sold Out</span>
          <% elsif @event.tickets_available_from.present? && @event.tickets_available_from > Time.current %>
            <p class="text-sm text-gray-500">On sale from <strong class="text-gray-700"><%= @event.tickets_available_from.strftime("%A %d %B at %-l:%M%P") %></strong></p>
          <% else %>
            <%= link_to "Get Tickets →", new_event_tickets_path(@event), class: "block w-full text-center px-6 py-3 btn-primary rounded-xl font-semibold text-sm", style: "color: white;" %>
            <% if scarcity_label && scarcity_label != "Tickets still available" %>
              <p class="text-center text-xs text-orange-600 font-medium mt-2"><%= scarcity_label %></p>
            <% end %>
          <% end %>
        <% elsif @event.ticket_url.present? %>
          <%= link_to "Get Tickets →", @event.ticket_url, class: "block w-full text-center px-6 py-3 btn-primary rounded-xl font-semibold text-sm", style: "color: white;", target: "_blank", rel: "noopener" %>
        <% end %>
      </div>
    <% end %>
  </article>

  <% if @event.qr_code.attached? %>
    <div class="mt-10 pt-8 border-t border-gray-200 not-prose print:mt-4">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Share this event</p>
      <div class="flex items-start gap-4">
        <%= image_tag @event.qr_code, alt: "QR code for #{@event.title}", class: "w-28 h-28", width: 112, height: 112 %>
        <div class="text-sm text-gray-600 self-center">
          <p>Scan to view event details</p>
          <p class="mt-1 font-mono text-xs text-gray-400 break-all"><%= event_url(@event) %></p>
        </div>
      </div>
    </div>
  <% end %>

  <% if @event.editable_by?(Current.user) && @event.tickets.any? %>
    <div class="mt-10 pt-8 border-t border-gray-200 print:hidden">
      <h2 class="text-base font-semibold text-gray-900 mb-1">Tickets sold</h2>
      <% paid = @event.tickets.paid %>
      <p class="text-sm text-gray-500 mb-4">
        <%= paid.sum(:quantity) %> <%= "ticket".pluralize(paid.sum(:quantity)) %> &middot;
        €<%= number_with_precision(paid.sum(:amount_cents) / 100.0, precision: 2) %> total
      </p>
      <div class="overflow-x-auto rounded-xl border border-gray-200">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-gray-500 uppercase text-xs tracking-wide">
            <tr>
              <th class="px-4 py-3 text-left font-medium">Name</th>
              <th class="px-4 py-3 text-left font-medium hidden sm:table-cell">Email</th>
              <th class="px-4 py-3 text-center font-medium">Qty</th>
              <th class="px-4 py-3 text-right font-medium">Amount</th>
              <th class="px-4 py-3 text-center font-medium">Status</th>
              <th class="px-4 py-3 text-right font-medium hidden sm:table-cell">Date</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <% @event.tickets.order(created_at: :desc).each do |ticket| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 font-medium text-gray-900"><%= ticket.buyer_name %></td>
                <td class="px-4 py-3 text-gray-600 hidden sm:table-cell"><%= ticket.buyer_email %></td>
                <td class="px-4 py-3 text-center text-gray-700"><%= ticket.quantity %></td>
                <td class="px-4 py-3 text-right text-gray-700">€<%= number_with_precision(ticket.amount_cents / 100.0, precision: 2) %></td>
                <td class="px-4 py-3 text-center">
                  <% case ticket.status %>
                  <% when "paid" %>
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-200">Paid</span>
                  <% when "pending" %>
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-50 text-yellow-700 border border-yellow-200">Pending</span>
                  <% when "failed" %>
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-red-50 text-red-700 border border-red-200">Failed</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-right text-gray-500 hidden sm:table-cell"><%= ticket.created_at.strftime("%-d %b %Y") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <% if @event.editable_by?(Current.user) %>
    <div class="flex flex-wrap gap-4 mt-12 pt-8 border-t border-gray-200 print:hidden">
      <%= link_to "Edit", edit_event_path(@event), class: "px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 text-sm" %>
      <% if @event.publishable_by?(Current.user) %>
        <% if @event.published? %>
          <%= button_to "Unpublish", unpublish_event_path(@event), method: :patch, class: "px-4 py-2 bg-yellow-600 text-white rounded hover:bg-yellow-700 text-sm" %>
        <% else %>
          <%= button_to "Publish", publish_event_path(@event), method: :patch, class: "px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm" %>
        <% end %>
      <% end %>
      <%= button_to "Delete", event_path(@event), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 text-sm" %>
    </div>
  <% end %>
</div>
