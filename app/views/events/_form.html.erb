<%= form_with model: event, class: "space-y-6" do |form| %>
  <% if event.errors.any? %>
    <div class="form-error">
      <h2><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-input" %>
  </div>

  <div>
    <%= form.label :image, "Event Image/Poster", class: "form-label" %>
    <% if event.image.attached? && event.image.blob.persisted? %>
      <div class="mt-2 mb-2">
        <%= image_tag event.image, class: "max-w-xs rounded-xl" %>
      </div>
    <% end %>
    <%= form.file_field :image, accept: "image/*", class: "form-file" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <%= form.label :starts_at, class: "form-label" %>
      <%= form.datetime_local_field :starts_at, class: "form-input" %>
    </div>
  </div>

  <div>
    <%= form.label :rich_description, "Description", class: "form-label mb-2" %>
    <%= form.rich_text_area :rich_description %>
  </div>

  <% if Current.user&.can_edit? %>
    <div>
      <%= form.label :user_id, "Event Owner", class: "form-label" %>
      <%= form.select :user_id, User.order(:email_address).map { |u| [u.email_address, u.id] }, {}, class: "form-input" %>
    </div>
  <% end %>

  <div class="border border-gray-200 rounded-xl p-5 space-y-4">
    <h3 class="font-semibold text-gray-800">Ticketing</h3>

    <div class="flex items-center gap-3">
      <%= form.check_box :ticketing_enabled, class: "rounded" %>
      <%= form.label :ticketing_enabled, "Enable ticket sales through this site", class: "text-sm text-gray-700" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :ticket_price_cents, "Ticket price (€)", class: "form-label" %>
        <div class="relative">
          <input type="number" name="event[ticket_price_cents_euros]" id="event_ticket_price_cents_euros"
                 value="<%= event.ticket_price_cents.present? ? event.ticket_price_cents / 100.0 : "" %>"
                 min="0" step="0.01"
                 class="form-input pl-8 w-full">
        </div>
        <p class="text-xs text-gray-400 mt-1">Leave blank if not ticketed.</p>
      </div>

      <div>
        <%= form.label :capacity, "Capacity", class: "form-label" %>
        <%= form.number_field :capacity, class: "form-input", min: 1 %>
        <p class="text-xs text-gray-400 mt-1">Maximum attendees (e.g. 50).</p>
      </div>
    </div>

    <div>
      <%= form.label :tickets_available_from, "Tickets on sale from", class: "form-label" %>
      <%= form.datetime_local_field :tickets_available_from, class: "form-input" %>
      <p class="text-xs text-gray-400 mt-1">Leave blank to sell immediately once ticketing is enabled.</p>
    </div>
  </div>

  <div class="flex items-center justify-end gap-4 pt-4 border-t border-gray-100">
    <%= link_to "Cancel", events_path, class: "text-gray-600 hover:text-gray-900" %>
    <%= form.submit class: "btn-primary text-white px-6 py-2.5 rounded-xl font-medium cursor-pointer" %>
  </div>
<% end %>
