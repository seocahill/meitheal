<div class="max-w-4xl mx-auto px-4 sm:px-6">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Edit Event</h1>

  <% unless @event.published? %>
    <div class="bg-amber-50 border-l-4 border-amber-400 text-amber-800 px-4 py-3 rounded-r-lg mb-6">
      This event is currently a draft and not visible to the public.
    </div>
  <% end %>

  <div class="card p-6">
    <%= render "form", event: @event %>
  </div>
</div>
