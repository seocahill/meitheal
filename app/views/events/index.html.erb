<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Events</h1>
    <% if authenticated? %>
      <%= link_to "Create Event", new_event_path, class: "bg-pink-600 text-white px-4 py-2 rounded hover:bg-pink-700" %>
    <% end %>
  </div>

  <% if @events.empty? %>
    <p class="text-gray-600">No upcoming events.</p>
  <% else %>
    <div class="space-y-6">
      <% @events.each do |event| %>
        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
          <h2 class="text-xl font-semibold mb-2">
            <%= link_to event.title, event, class: "hover:text-pink-600" %>
          </h2>
          <p class="text-gray-600 mb-2">
            <time datetime="<%= event.starts_at.iso8601 %>">
              <%= event.starts_at.strftime("%A, %B %d, %Y at %l:%M %p") %>
            </time>
          </p>
          <% if event.venue_name.present? %>
            <p class="text-gray-500"><%= event.venue_name %></p>
          <% end %>
          <% if event.description.present? %>
            <p class="text-gray-700 mt-4"><%= truncate(event.description, length: 200) %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
