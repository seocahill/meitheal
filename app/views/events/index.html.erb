<div class="max-w-6xl mx-auto px-4 sm:px-6">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Events</h1>
    <% if authenticated? %>
      <%= link_to "Create Event", new_event_path, class: "btn-primary text-white px-5 py-2.5 rounded-xl font-medium" %>
    <% end %>
  </div>

  <% if @events.empty? %>
    <div class="card p-12 text-center">
      <p class="text-gray-500 text-lg">No upcoming events yet.</p>
      <% if authenticated? %>
        <p class="mt-4">
          <%= link_to "Create the first event", new_event_path, class: "link-accent font-medium" %>
        </p>
      <% end %>
    </div>
  <% else %>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% @events.each do |event| %>
        <div class="card p-6 flex flex-col">
          <div class="flex-1">
            <p class="text-sm font-medium text-purple-600 mb-2">
              <%= event.starts_at.strftime("%a, %b %d") %>
              <% if event.venue_name.present? %>
                &middot; <%= event.venue_name %>
              <% end %>
            </p>
            <h2 class="text-xl font-semibold text-gray-900 mb-3">
              <%= link_to event.title, event, class: "hover:text-purple-600 transition-colors" %>
            </h2>
            <% if event.description.present? %>
              <p class="text-gray-600 text-sm line-clamp-3"><%= truncate(event.description, length: 150) %></p>
            <% end %>
          </div>
          <div class="mt-4 pt-4 border-t border-gray-100 flex justify-between items-center">
            <time class="text-sm text-gray-500" datetime="<%= event.starts_at.iso8601 %>">
              <%= event.starts_at.strftime("%l:%M %p").strip %>
            </time>
            <%= link_to "Details →", event, class: "text-sm font-medium link-accent" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
