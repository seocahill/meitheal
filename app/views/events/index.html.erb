<div class="max-w-2xl mx-auto px-4 py-8">
  <header class="mb-8">
    <h1 class="text-2xl font-bold tracking-wide uppercase"><%= t("events") %></h1>
    <% if authenticated? %>
      <p class="mt-2">
        <%= link_to "Create Event", new_event_path, class: "text-sm text-gray-600 hover:text-gray-900 underline" %>
      </p>
    <% end %>
  </header>

  <% if @events.empty? %>
    <p class="text-gray-500"><%= t("no_events") %></p>
  <% else %>
    <div class="space-y-12">
      <% @events.each do |event| %>
        <article>
          <% if event.image.attached? %>
            <%= link_to event do %>
              <%= image_tag event.image, alt: event.title, class: "w-full aspect-[16/9] object-cover mb-4" %>
            <% end %>
          <% end %>

          <h2 class="text-xl font-semibold mb-1">
            <%= link_to event.title, event, class: "underline hover:text-gray-600" %>
            <% unless event.published? %>
              <span class="ml-2 text-xs font-normal text-yellow-600 bg-yellow-100 px-2 py-1 rounded"><%= t("draft") %></span>
            <% end %>
          </h2>

          <p class="text-gray-500 text-sm mb-2">
            <%= event.starts_at.strftime('%B %d, %Y') %>
          </p>

          <%= link_to t("read_more"), event, class: "text-sm underline hover:text-gray-600" %>
        </article>
      <% end %>
    </div>

    <nav class="mt-12 text-center text-sm">
      <%== @pagy.series_nav %>
    </nav>
  <% end %>
</div>
