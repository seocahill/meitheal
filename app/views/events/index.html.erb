<div class="max-w-3xl mx-auto px-4 py-6">
  <div class="mb-8">
    <h1 class="text-5xl font-bold mb-2">Events</h1>
    <% if authenticated? %>
      <%= link_to "Create Event", new_event_path, class: "text-sm text-pink-600 hover:text-pink-800" %>
    <% end %>
  </div>

  <% if @events.empty? %>
    <p class="text-gray-500">No events yet.</p>
  <% else %>
    <div class="space-y-8">
      <% @events.each do |event| %>
        <article>
          <% if event.image.attached? %>
            <%= link_to event do %>
              <%= image_tag event.image, alt: event.title, class: "w-full h-96 object-cover mb-4" %>
            <% end %>
          <% end %>

          <h2 class="text-4xl font-bold mb-2">
            <%= link_to event.title, event, class: "hover:text-pink-600" %>
          </h2>

          <p class="text-gray-600 text-lg mb-3">
            <%= event.starts_at.strftime('%B %d, %Y') %>
          </p>

          <% if event.description.present? %>
            <div class="text-gray-700 text-lg mb-3">
              <%= sanitize(event.description.truncate(200, separator: ' ')) %>
            </div>
          <% end %>

          <%= link_to "Read more →", event, class: "text-pink-600 hover:text-pink-800 text-lg" %>
        </article>
      <% end %>
    </div>

    <div class="mt-8">
      <%== @pagy.series_nav %>
    </div>
  <% end %>
</div>
