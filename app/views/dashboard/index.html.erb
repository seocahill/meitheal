<div class="max-w-7xl mx-auto px-4 sm:px-6">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-bold text-gray-900">
      Welcome, <%= @user.profile&.name || @user.email_address.split("@").first %>
    </h1>
  </div>

  <% if @user.can_manage? %>
    <!-- Admin Section -->
    <div class="mb-10">
      <h2 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
        <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
        Admin Actions
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Pending Users -->
        <div class="card p-5">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-gray-900">Pending Users</h3>
            <% if @pending_users.any? %>
              <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full"><%= @pending_users.size %></span>
            <% end %>
          </div>
          <% if @pending_users.any? %>
            <ul class="space-y-2 mb-4">
              <% @pending_users.each do |user| %>
                <li class="flex items-center justify-between text-sm">
                  <span class="text-gray-700 truncate"><%= user.profile&.name || user.email_address %></span>
                  <%= button_to "Approve", approve_admin_user_path(user), method: :post, class: "text-green-600 hover:text-green-800 text-xs font-medium" %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-gray-500">No pending approvals</p>
          <% end %>
          <%= link_to "View all users →", admin_users_path, class: "text-sm text-purple-600 hover:text-purple-700" %>
        </div>

        <!-- Pending Proposals -->
        <div class="card p-5">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-gray-900">Submitted Proposals</h3>
            <% if @pending_proposals.any? %>
              <span class="bg-blue-100 text-blue-700 text-xs font-medium px-2 py-1 rounded-full"><%= @pending_proposals.size %></span>
            <% end %>
          </div>
          <% if @pending_proposals.any? %>
            <ul class="space-y-2 mb-4">
              <% @pending_proposals.each do |proposal| %>
                <li class="text-sm">
                  <%= link_to admin_proposal_path(proposal), class: "text-gray-700 hover:text-purple-600" do %>
                    <span class="font-medium"><%= truncate(proposal.title, length: 30) %></span>
                    <span class="text-gray-500">by <%= proposal.user.profile&.name || proposal.user.email_address.split("@").first %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-gray-500">No proposals to review</p>
          <% end %>
          <%= link_to "View all proposals →", admin_proposals_path, class: "text-sm text-purple-600 hover:text-purple-700" %>
        </div>

        <!-- Admin Todos -->
        <% if @admin_todos %>
          <div class="card p-5">
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-semibold text-gray-900">Admin Todos</h3>
              <% if @admin_todos.any? %>
                <span class="bg-rose-100 text-rose-700 text-xs font-medium px-2 py-1 rounded-full"><%= @admin_todos.size %></span>
              <% end %>
            </div>
            <% if @admin_todos.any? %>
              <ul class="space-y-2 mb-4">
                <% @admin_todos.take(5).each do |todo| %>
                  <li class="text-sm text-gray-700 truncate"><%= todo.title %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-sm text-gray-500">All caught up!</p>
            <% end %>
            <%= link_to "View all todos →", admin_todos_path, class: "text-sm text-purple-600 hover:text-purple-700" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @user.can_edit? %>
    <!-- Editor Section -->
    <div class="mb-10">
      <h2 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
        <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
        Editorial Actions
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Pending Bookings -->
        <div class="card p-5">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-gray-900">Pending Bookings</h3>
            <% if @pending_bookings.any? %>
              <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2 py-1 rounded-full"><%= @pending_bookings.size %></span>
            <% end %>
          </div>
          <% if @pending_bookings.any? %>
            <ul class="space-y-2 mb-4">
              <% @pending_bookings.take(5).each do |booking| %>
                <li class="flex items-center justify-between text-sm">
                  <div class="truncate">
                    <span class="text-gray-700"><%= booking.title %></span>
                    <span class="text-gray-500 text-xs block"><%= booking.starts_at.strftime("%b %d, %H:%M") %></span>
                  </div>
                  <%= button_to "Confirm", confirm_booking_path(booking), method: :patch, class: "text-green-600 hover:text-green-800 text-xs font-medium" %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-gray-500">No pending bookings</p>
          <% end %>
          <%= link_to "View calendar →", calendar_path, class: "text-sm text-purple-600 hover:text-purple-700" %>
        </div>

        <!-- Draft Events -->
        <div class="card p-5">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-gray-900">Draft Events</h3>
            <% if @draft_events.any? %>
              <span class="bg-gray-100 text-gray-700 text-xs font-medium px-2 py-1 rounded-full"><%= @draft_events.size %></span>
            <% end %>
          </div>
          <% if @draft_events.any? %>
            <ul class="space-y-2 mb-4">
              <% @draft_events.take(5).each do |event| %>
                <li class="flex items-center justify-between text-sm">
                  <span class="text-gray-700 truncate"><%= event.title %></span>
                  <%= link_to "Review", event_path(event), class: "text-purple-600 hover:text-purple-700 text-xs font-medium" %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-gray-500">No draft events</p>
          <% end %>
          <%= link_to "All events →", events_path, class: "text-sm text-purple-600 hover:text-purple-700" %>
        </div>

        <!-- Draft Newsletters -->
        <div class="card p-5">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-gray-900">Draft Newsletters</h3>
            <% if @draft_newsletters.any? %>
              <span class="bg-gray-100 text-gray-700 text-xs font-medium px-2 py-1 rounded-full"><%= @draft_newsletters.size %></span>
            <% end %>
          </div>
          <% if @draft_newsletters.any? %>
            <ul class="space-y-2 mb-4">
              <% @draft_newsletters.each do |newsletter| %>
                <li class="text-sm">
                  <%= link_to edit_newsletter_path(newsletter), class: "text-gray-700 hover:text-purple-600" do %>
                    <%= truncate(newsletter.subject, length: 35) %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-gray-500">No drafts in progress</p>
          <% end %>
          <%= link_to "All newsletters →", newsletters_path, class: "text-sm text-purple-600 hover:text-purple-700" %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Action Items for Members -->
  <div class="mb-10">
    <% needs_attention = !@profile_complete || !@has_active_membership %>
    <% if needs_attention %>
      <div class="bg-gradient-to-r from-purple-50 to-pink-50 border border-purple-100 rounded-xl p-6 mb-6">
        <h2 class="font-semibold text-gray-900 mb-4">Get started</h2>
        <div class="space-y-3">
          <% unless @profile_complete %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center text-purple-600">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </span>
                <div>
                  <p class="text-sm font-medium text-gray-900">Complete your profile</p>
                  <p class="text-xs text-gray-500">Help other members find and collaborate with you</p>
                </div>
              </div>
              <%= link_to "Update profile", my_profile_path, class: "text-sm font-medium text-purple-600 hover:text-purple-700" %>
            </div>
          <% end %>
          <% if @membership && !@has_active_membership %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-amber-600">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                </span>
                <div>
                  <p class="text-sm font-medium text-gray-900">Renew your membership</p>
                  <p class="text-xs text-gray-500">Required for booking spaces and full access</p>
                </div>
              </div>
              <%= link_to "Pay now", new_membership_payment_path(@membership), class: "text-sm font-medium text-purple-600 hover:text-purple-700" %>
            </div>
          <% elsif !@membership %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                </span>
                <div>
                  <p class="text-sm font-medium text-gray-900">Become a full member</p>
                  <p class="text-xs text-gray-500">Book spaces, apply for funding, and support the co-op</p>
                </div>
              </div>
              <%= link_to "Learn more", new_membership_payment_path(@membership), class: "text-sm font-medium text-purple-600 hover:text-purple-700" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- What can I do? -->
    <h2 class="text-lg font-semibold text-gray-700 mb-4">What can I do?</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <%= link_to new_booking_path, class: "card p-4 text-center hover:shadow-md transition-shadow group" do %>
        <div class="w-10 h-10 mx-auto mb-2 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 group-hover:bg-blue-100">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <p class="text-sm font-medium text-gray-900">Book a space</p>
      <% end %>

      <%= link_to funding_opportunities_path, class: "card p-4 text-center hover:shadow-md transition-shadow group" do %>
        <div class="w-10 h-10 mx-auto mb-2 rounded-full bg-green-50 flex items-center justify-center text-green-600 group-hover:bg-green-100">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p class="text-sm font-medium text-gray-900">Apply for funding</p>
      <% end %>

      <%= link_to new_event_path, class: "card p-4 text-center hover:shadow-md transition-shadow group" do %>
        <div class="w-10 h-10 mx-auto mb-2 rounded-full bg-purple-50 flex items-center justify-center text-purple-600 group-hover:bg-purple-100">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
        </div>
        <p class="text-sm font-medium text-gray-900">List an event</p>
      <% end %>

      <%= link_to thredded_path, class: "card p-4 text-center hover:shadow-md transition-shadow group" do %>
        <div class="w-10 h-10 mx-auto mb-2 rounded-full bg-indigo-50 flex items-center justify-center text-indigo-600 group-hover:bg-indigo-100">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/></svg>
        </div>
        <p class="text-sm font-medium text-gray-900">Join the forum</p>
      <% end %>
    </div>

    <% if @membership && @has_active_membership %>
      <p class="text-sm text-gray-500 mb-6">
        Membership active until <%= @membership.expires_on&.strftime("%b %d, %Y") || "ongoing" %>.
        <%= link_to "Make a donation", new_membership_payment_path(@membership), class: "text-purple-600 hover:text-purple-700" %>
      </p>
    <% end %>
  </div>

  <!-- Forum Activity -->
  <% if @recent_topics.any? %>
    <div class="mb-10">
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Latest from the forum</h2>
      <div class="space-y-2">
        <% @recent_topics.each do |topic| %>
          <%= link_to thredded.messageboard_topic_path(topic.messageboard, topic), class: "block card p-3 hover:shadow-md transition-shadow" do %>
            <div class="flex items-center justify-between gap-4">
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-900 truncate"><%= topic.title %></p>
                <p class="text-xs text-gray-500"><%= topic.messageboard.name %> · <%= time_ago_in_words(topic.last_post_at || topic.created_at) %> ago</p>
              </div>
              <span class="text-xs text-gray-400"><%= topic.posts_count %> posts</span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Unpaid Bookings Warning -->
  <% if @unpaid_bookings.any? %>
    <div class="mb-6 bg-amber-50 border border-amber-200 rounded-lg p-4">
      <h2 class="text-lg font-semibold text-amber-900 mb-2">⚠️ Unpaid Bookings</h2>
      <p class="text-sm text-amber-800 mb-3">You have <%= pluralize(@unpaid_bookings.count, "unpaid booking") %>. Please settle outstanding payments before making new bookings.</p>
      <ul class="space-y-2">
        <% @unpaid_bookings.each do |booking| %>
          <li class="text-sm text-amber-900">
            <strong><%= booking.title %></strong> — <%= booking.space.name %>, <%= booking.starts_at.strftime("%B %d, %Y") %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Your Activity (only show if they have bookings, proposals, or draft events) -->
  <% if @my_bookings.any? || @my_proposals.any? || @my_draft_events.any? || @my_tickets.any? %>
    <div>
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Your activity</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% if @my_tickets.any? %>
          <div class="card p-4">
            <h3 class="text-sm font-medium text-gray-700 mb-3">My Tickets</h3>
            <ul class="space-y-2">
              <% @my_tickets.each do |ticket| %>
                <li class="flex items-center justify-between text-sm gap-2">
                  <%= link_to ticket.event.title, event_path(ticket.event), class: "text-gray-900 hover:text-purple-600 truncate" %>
                  <span class="text-xs text-gray-500 whitespace-nowrap">
                    <%= ticket.event.starts_at.strftime("%b %d") %><%= " · ×#{ticket.quantity}" if ticket.quantity > 1 %>
                  </span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <% if @my_bookings.any? %>
          <div class="card p-4">
            <h3 class="text-sm font-medium text-gray-700 mb-3">Upcoming bookings</h3>
            <ul class="space-y-2">
              <% @my_bookings.each do |booking| %>
                <li class="flex items-center justify-between text-sm">
                  <span class="text-gray-900"><%= booking.title %></span>
                  <span class="text-xs text-gray-500"><%= booking.starts_at.strftime("%b %d") %></span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <% if @my_proposals.any? %>
          <div class="card p-4">
            <h3 class="text-sm font-medium text-gray-700 mb-3">Your proposals</h3>
            <ul class="space-y-2">
              <% @my_proposals.each do |proposal| %>
                <li class="flex items-center justify-between text-sm">
                  <span class="text-gray-900 truncate"><%= truncate(proposal.title, length: 25) %></span>
                  <span class="text-xs px-2 py-0.5 rounded-full
                    <%= case proposal.status
                        when 'draft' then 'bg-gray-100 text-gray-600'
                        when 'submitted' then 'bg-blue-100 text-blue-600'
                        when 'approved' then 'bg-green-100 text-green-600'
                        when 'rejected' then 'bg-rose-100 text-rose-600'
                        end %>">
                    <%= proposal.status %>
                  </span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <% if @my_draft_events.any? %>
          <div class="card p-4">
            <h3 class="text-sm font-medium text-gray-700 mb-3">Draft events</h3>
            <ul class="space-y-2">
              <% @my_draft_events.each do |event| %>
                <li class="flex items-center justify-between text-sm gap-2">
                  <%= link_to event.title, event_path(event), class: "text-gray-900 hover:text-purple-600 truncate" %>
                  <%= link_to "Edit", edit_event_path(event), class: "text-xs text-purple-600 hover:text-purple-700 whitespace-nowrap" %>
                </li>
              <% end %>
            </ul>
            <%= link_to "View all events →", events_path, class: "text-xs text-purple-600 hover:text-purple-700 mt-3 inline-block" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
