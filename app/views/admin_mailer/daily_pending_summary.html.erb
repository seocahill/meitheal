<h1>Daily Summary</h1>

<% if @email_digest.present? %>
  <h2>Email digest</h2>
  <%= simple_format(@email_digest) %>
<% end %>

<p>The following items are awaiting your action:</p>

<% if @pending_users.any? %>
  <h2>Users pending approval (<%= @pending_users.count %>)</h2>
  <ul>
    <% @pending_users.each do |user| %>
      <li><%= user.profile&.name || user.email_address %> — registered <%= user.created_at.strftime("%d %B %Y") %></li>
    <% end %>
  </ul>
  <p><%= link_to "Review pending users", admin_users_url(approved: "pending") %></p>
<% end %>

<% if @pending_funding_opportunities.any? %>
  <h2>Funding opportunities pending approval (<%= @pending_funding_opportunities.count %>)</h2>
  <ul>
    <% @pending_funding_opportunities.each do |opportunity| %>
      <li><strong><%= opportunity.title %></strong> — <%= opportunity.organization %> (deadline: <%= opportunity.deadline.strftime("%d %B %Y") %>)</li>
    <% end %>
  </ul>
  <p><%= link_to "Review pending funding opportunities", admin_funding_opportunities_url %></p>
<% end %>

<% if @pending_proposals.any? %>
  <h2>Proposals pending review (<%= @pending_proposals.count %>)</h2>
  <ul>
    <% @pending_proposals.each do |proposal| %>
      <li><strong><%= proposal.title %></strong> — submitted by <%= proposal.user.email_address %> on <%= proposal.submitted_at&.strftime("%d %B %Y") || "unknown date" %></li>
    <% end %>
  </ul>
  <p><%= link_to "Review pending proposals", admin_proposals_url %></p>
<% end %>

<% if @pending_bookings.any? %>
  <h2>Bookings awaiting confirmation (<%= @pending_bookings.count %>)</h2>
  <ul>
    <% @pending_bookings.each do |booking| %>
      <li><strong><%= booking.title %></strong> — <%= booking.user.email_address %>, <%= booking.starts_at.strftime("%d %B %Y at %H:%M") %></li>
    <% end %>
  </ul>
  <p><%= link_to "View calendar", calendar_url %></p>
<% end %>

<% if @draft_events.any? %>
  <h2>Events awaiting publication (<%= @draft_events.count %>)</h2>
  <ul>
    <% @draft_events.each do |event| %>
      <li><strong><%= event.title %></strong> — created by <%= event.user.email_address %>, starts <%= event.starts_at.strftime("%d %B %Y") %></li>
    <% end %>
  </ul>
  <p><%= link_to "View events", events_url %></p>
<% end %>

<% if @unpaid_bookings.any? %>
  <h2>Bookings awaiting payment (<%= @unpaid_bookings.count %>)</h2>
  <ul>
    <% @unpaid_bookings.each do |booking| %>
      <li><strong><%= booking.title %></strong> — <%= booking.user.email_address %>, <%= booking.space.name %>, <%= booking.starts_at.strftime("%d %B %Y") %></li>
    <% end %>
  </ul>
  <p><%= link_to "View calendar", calendar_url %></p>
<% end %>
