<%= form_with model: [@funding_opportunity, @proposal], class: "space-y-6" do |f| %>
  <% if @proposal.errors.any? %>
    <div class="form-error">
      <h3>Please fix the following errors:</h3>
      <ul class="mt-2 list-disc list-inside">
        <% @proposal.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if current_user_can_edit? && @users %>
    <div>
      <%= f.label :user_id, "Proposer", class: "form-label" %>
      <p class="form-hint mb-2">Select the member submitting this proposal.</p>
      <%= f.collection_select :user_id, @users, :id, :email_address, { include_blank: "Select a member..." }, { class: "form-input" } %>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "form-label" %>
    <p class="form-hint mb-2">The title of your project/proposal.</p>
    <%= f.text_field :title, class: "form-input", required: true %>
  </div>

  <div>
    <%= f.label :description, class: "form-label" %>
    <p class="form-hint mb-2">Describe your project, its goals, and how the funding would be used.</p>
    <%= f.text_area :description, rows: 10, class: "form-input" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="flex flex-col">
      <%= f.label :submission_deadline, "Application Deadline", class: "form-label" %>
      <p class="form-hint mb-2">When must this application be submitted to the funder?</p>
      <div class="mt-auto">
        <%= f.date_field :submission_deadline, class: "form-input" %>
      </div>
    </div>

    <div class="flex flex-col">
      <%= f.label :amount_requested, "Amount Requested", class: "form-label" %>
      <p class="form-hint mb-2">Total amount you're applying for.</p>
      <div class="relative mt-auto">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">&euro;</span>
        <%= f.number_field :amount_requested, class: "form-input pl-8", min: 0, step: 0.01 %>
      </div>
    </div>

    <div class="flex flex-col">
      <%= f.label :organizer_fee, "Organizer Fee", class: "form-label" %>
      <p class="form-hint mb-2">Your fee for organizing (0 if none).</p>
      <div class="relative mt-auto">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">&euro;</span>
        <%= f.number_field :organizer_fee, class: "form-input pl-8", min: 0, step: 0.01, value: @proposal.organizer_fee || 0 %>
      </div>
    </div>
  </div>

  <div>
    <%= f.label :documents, "Attachments", class: "form-label" %>
    <p class="form-hint mb-2">Upload supporting documents (PDFs, images, etc.).</p>
    <%= f.file_field :documents, multiple: true, class: "form-input", accept: ".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif" %>

    <% if @proposal.documents.any? %>
      <div class="mt-3 space-y-2">
        <% @proposal.documents.each do |doc| %>
          <div class="flex items-center gap-2 text-sm text-gray-600">
            <% if doc.content_type.start_with?("image/") %>
              <svg class="w-4 h-4 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <% else %>
              <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            <% end %>
            <%= link_to doc.filename, rails_blob_path(doc, disposition: "inline"), target: "_blank", class: "text-purple-600 hover:text-purple-800" %>
            <span class="text-gray-400">(<%= number_to_human_size(doc.byte_size) %>)</span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
    <p class="font-medium mb-1">Before submitting:</p>
    <p>Make sure all fields are filled in. You can save as draft and come back later to complete.</p>
  </div>

  <div class="flex items-center gap-4 pt-4 border-t border-gray-100">
    <%= f.submit @proposal.persisted? ? "Update Proposal" : "Save Draft", class: "btn-primary text-white px-6 py-2.5 rounded-xl font-medium cursor-pointer" %>
    <%= link_to "Cancel", @funding_opportunity, class: "text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
