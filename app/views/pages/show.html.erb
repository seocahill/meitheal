<div class="max-w-4xl mx-auto px-4">
  <% if !@page.published? %>
    <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-6">
      This page is a draft and not visible to the public.
    </div>
  <% end %>

  <article>
    <header class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900"><%= @page.title %></h1>
    </header>

    <div class="prose prose-lg max-w-none">
      <%= @page.content %>
    </div>
  </article>

  <% if current_user_can_edit? %>
    <div class="mt-12 pt-6 border-t border-gray-200 flex gap-4">
      <%= link_to "Edit Page", edit_admin_page_path(@page), class: "text-pink-600 hover:text-pink-800" %>
      <% if @page.published? %>
        <%= button_to "Unpublish", unpublish_admin_page_path(@page), method: :patch, class: "text-gray-600 hover:text-gray-800" %>
      <% else %>
        <%= button_to "Publish", publish_admin_page_path(@page), method: :patch, class: "bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
      <% end %>
    </div>
  <% end %>
</div>
