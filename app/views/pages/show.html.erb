<div class="max-w-2xl mx-auto px-4 py-8">
  <% if !@page.published? %>
    <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-6">
      This page is a draft and not visible to the public.
    </div>
  <% end %>

  <article class="prose prose-lg max-w-none">
    <h1 class="text-3xl font-bold mb-8"><%= @page.title %></h1>

    <%= @page.content %>
  </article>

  <% if current_user_can_edit? %>
    <div class="flex flex-wrap gap-4 mt-12 pt-8 border-t border-gray-200">
      <%= link_to "Edit Page", edit_admin_page_path(@page), class: "px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 text-sm" %>
      <% if @page.published? %>
        <%= button_to "Unpublish", unpublish_admin_page_path(@page), method: :patch, class: "px-4 py-2 bg-yellow-600 text-white rounded hover:bg-yellow-700 text-sm" %>
      <% else %>
        <%= button_to "Publish", publish_admin_page_path(@page), method: :patch, class: "px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm" %>
      <% end %>
    </div>
  <% end %>
</div>
