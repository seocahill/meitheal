<div style="font-family: sans-serif; max-width: 600px; margin: 0 auto;">
  <div style="background-color: #f9fafb; padding: 16px; border-bottom: 1px solid #e5e7eb;">
    <p style="margin: 0; color: #6b7280; font-size: 14px;">
      Message from <strong><%= @archived_email.from_address %></strong> to <%= @group.name %>
    </p>
  </div>

  <div style="padding: 16px;">
    <%= simple_format(@archived_email.body) %>
  </div>

  <div style="background-color: #f9fafb; padding: 16px; border-top: 1px solid #e5e7eb; font-size: 12px; color: #6b7280;">
    <p style="margin: 0;">
      You received this email because you are a member of the <%= @group.name %> group (<%= @group.email_address %>).
    </p>
  </div>
</div>
