<%= form_with model: funding_opportunity, class: "space-y-6" do |form| %>
  <% if funding_opportunity.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <h2 class="font-bold"><%= pluralize(funding_opportunity.errors.count, "error") %> prohibited this opportunity from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% funding_opportunity.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div>
    <%= form.label :organization, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :organization, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500", placeholder: "e.g. Arts Council Ireland" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :deadline, class: "block text-sm font-medium text-gray-700" %>
      <%= form.date_field :deadline, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
    </div>

    <div>
      <%= form.label :amount, "Amount (EUR, optional)", class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :amount, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500", placeholder: "15000" %>
    </div>
  </div>

  <div>
    <%= form.label :url, "Website URL (optional)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.url_field :url, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500", placeholder: "https://..." %>
  </div>

  <div>
    <%= form.label :categories, "Categories (comma separated, optional)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :categories, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500", placeholder: "visual art, music, theatre" %>
  </div>

  <div>
    <%= form.label :description, "Description (optional)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :description, rows: 6, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div class="flex items-center justify-end gap-4">
    <%= link_to "Cancel", funding_opportunities_path, class: "text-gray-600 hover:text-gray-800" %>
    <%= form.submit class: "bg-pink-600 text-white px-6 py-2 rounded hover:bg-pink-700 cursor-pointer" %>
  </div>
<% end %>
