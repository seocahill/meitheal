<%= form_with model: funding_opportunity, class: "space-y-6" do |form| %>
  <% if funding_opportunity.errors.any? %>
    <div class="form-error">
      <h2><%= pluralize(funding_opportunity.errors.count, "error") %> prohibited this opportunity from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% funding_opportunity.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-input" %>
  </div>

  <div>
    <%= form.label :organization, class: "form-label" %>
    <%= form.text_field :organization, class: "form-input", placeholder: "e.g. Arts Council Ireland" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :deadline, class: "form-label" %>
      <%= form.date_field :deadline, class: "form-input" %>
    </div>

    <div>
      <%= form.label :amount, "Amount (EUR, optional)", class: "form-label" %>
      <%= form.number_field :amount, class: "form-input", placeholder: "15000" %>
    </div>
  </div>

  <div>
    <%= form.label :url, "Website URL (optional)", class: "form-label" %>
    <%= form.url_field :url, class: "form-input", placeholder: "https://..." %>
  </div>

  <div>
    <%= form.label :categories, "Categories (comma separated, optional)", class: "form-label" %>
    <%= form.text_field :categories, class: "form-input", placeholder: "visual art, music, theatre" %>
  </div>

  <div>
    <%= form.label :description, "Description (optional)", class: "form-label" %>
    <%= form.text_area :description, rows: 6, class: "form-input" %>
  </div>

  <div class="flex items-center justify-end gap-4 pt-4 border-t border-gray-100">
    <%= link_to "Cancel", funding_opportunities_path, class: "text-gray-600 hover:text-gray-900" %>
    <%= form.submit class: "btn-primary text-white px-6 py-2.5 rounded-xl font-medium cursor-pointer" %>
  </div>
<% end %>
