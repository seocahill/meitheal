<style>
  @media print {
    header, nav, footer, .print\:hidden { display: none !important; }
    body { background: white; }
    .receipt-card { box-shadow: none !important; border: 1px solid #e5e7eb !important; }
  }
</style>

<div class="max-w-lg mx-auto px-4 py-12">
  <div class="receipt-card bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden">
    <div class="px-8 py-6 bg-gradient-to-r from-purple-600 to-pink-500 text-white text-center">
      <p class="text-4xl mb-2">&#10003;</p>
      <h1 class="text-xl font-bold">Payment confirmed</h1>
      <p class="text-sm opacity-80 mt-1">A confirmation has been sent to <%= @ticket.buyer_email %></p>
    </div>

    <div class="px-8 py-6">
      <table class="w-full text-sm">
        <tbody class="divide-y divide-gray-100">
          <tr class="py-3">
            <td class="py-3 text-gray-500 w-1/3">Event</td>
            <td class="py-3 font-medium text-gray-900"><%= @event.title %></td>
          </tr>
          <tr>
            <td class="py-3 text-gray-500">Date</td>
            <td class="py-3 font-medium text-gray-900"><%= @event.starts_at.strftime("%A %d %B %Y") %></td>
          </tr>
          <% if @event.doors_at.present? %>
          <tr>
            <td class="py-3 text-gray-500">Doors</td>
            <td class="py-3 font-medium text-gray-900"><%= @event.doors_at.strftime("%-l:%M%P") %></td>
          </tr>
          <% end %>
          <tr>
            <td class="py-3 text-gray-500">Name</td>
            <td class="py-3 font-medium text-gray-900"><%= @ticket.buyer_name %></td>
          </tr>
          <tr>
            <td class="py-3 text-gray-500">Tickets</td>
            <td class="py-3 font-medium text-gray-900"><%= @ticket.quantity %></td>
          </tr>
          <tr>
            <td class="py-3 text-gray-500">Total paid</td>
            <td class="py-3 font-semibold text-gray-900">&euro;<%= number_with_precision(@ticket.amount_cents / 100.0, precision: 2) %></td>
          </tr>
          <% if @ticket.sumup_transaction_id.present? %>
          <tr>
            <td class="py-3 text-gray-500">Reference</td>
            <td class="py-3 font-mono text-xs text-gray-500"><%= @ticket.sumup_transaction_id %></td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-8 pb-8 flex flex-col sm:flex-row gap-3 print:hidden">
      <button onclick="window.print()" class="flex-1 text-center px-6 py-3 btn-primary rounded-xl font-semibold text-sm" style="color: white;">
        Save / Print PDF
      </button>
      <%= link_to "Back to event", event_path(@event), class: "flex-1 text-center px-6 py-3 btn-secondary rounded-xl font-semibold text-sm" %>
    </div>
  </div>
</div>
