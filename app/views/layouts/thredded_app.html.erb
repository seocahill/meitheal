<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Forum" %> &mdash; THENCF</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload", preload: false %>
    <%= stylesheet_link_tag "theme", "data-turbo-track": "reload", preload: false %>
    <%= javascript_importmap_tags %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <body class="bg-gray-50 min-h-screen">

    <nav class="nav-gradient">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex justify-between h-14 items-center">
          <a href="/" class="text-xl font-bold text-white hover:text-white/90">THENCF</a>
          <a href="/dashboard" class="text-white/80 hover:text-white text-sm font-medium">← Dashboard</a>
        </div>
      </div>
    </nav>

    <main class="py-6">
      <%= yield %>
    </main>

  </body>
</html>
