<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Forum" %> &mdash; THENCF</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="THENCF Forum">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload", preload: false %>
    <%= stylesheet_link_tag "thredded", "data-turbo-track": "reload", preload: false %>
    <%= stylesheet_link_tag "theme", "data-turbo-track": "reload", preload: false %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "thredded", "data-turbo-track": "reload", defer: true %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <body class="bg-gray-50 h-screen flex overflow-hidden">

    <aside class="w-56 flex-shrink-0 flex flex-col bg-gray-900 overflow-y-auto">

      <%# Brand %>
      <div class="h-14 flex items-center px-4 flex-shrink-0 nav-gradient">
        <%= link_to main_app.root_path, class: "text-white font-bold text-lg leading-none" do %>
          THENCF
        <% end %>
      </div>

      <%# Navigation %>
      <nav class="flex-1 p-2 space-y-0.5">

        <%= link_to "Dashboard", main_app.dashboard_path, class: "sidebar-nav-link" %>
        <%= link_to "Forum", thredded.root_path, class: "sidebar-nav-link sidebar-nav-active" %>

        <div class="sidebar-nav-section">Explore</div>
        <%= link_to "News", main_app.posts_path, class: "sidebar-nav-link" %>
        <%= link_to "Events", main_app.events_path, class: "sidebar-nav-link" %>
        <%= link_to "Gallery", main_app.artists_path, class: "sidebar-nav-link" %>
        <%= link_to "Projects", main_app.projects_path, class: "sidebar-nav-link" %>
        <%= link_to "Members", main_app.profiles_path, class: "sidebar-nav-link" %>

        <div class="sidebar-nav-section">Participate</div>
        <%= link_to "Funding", main_app.funding_opportunities_path, class: "sidebar-nav-link" %>
        <%= link_to "Book Space", main_app.new_booking_path, class: "sidebar-nav-link" %>
        <%= link_to "Make a Payment", main_app.new_payment_path, class: "sidebar-nav-link" %>

        <% if current_user&.can_edit? %>
          <div class="sidebar-nav-section">Manage</div>
          <%= link_to "Newsletters", main_app.newsletters_path, class: "sidebar-nav-link" %>
          <%= link_to "Pages", main_app.admin_pages_path, class: "sidebar-nav-link" %>
          <%= link_to "FAQs", main_app.admin_faqs_path, class: "sidebar-nav-link" %>
        <% end %>

        <% if current_user&.can_manage? %>
          <div class="sidebar-nav-section">Admin</div>
          <%= link_to "Inbox", main_app.admin_inbox_index_path, class: "sidebar-nav-link" %>
          <%= link_to "Email Groups", main_app.admin_email_groups_path, class: "sidebar-nav-link" %>
          <%= link_to "Users", main_app.admin_users_path, class: "sidebar-nav-link" %>
          <%= link_to "Memberships", main_app.admin_memberships_path, class: "sidebar-nav-link" %>
          <%= link_to "Payments", main_app.admin_payments_path, class: "sidebar-nav-link" %>
          <%= link_to "Transactions", main_app.admin_transactions_path, class: "sidebar-nav-link" %>
          <%= link_to "Bookings", main_app.admin_bookings_path, class: "sidebar-nav-link" %>
          <%= link_to "Proposals", main_app.admin_proposals_path, class: "sidebar-nav-link" %>
          <%= link_to "Funding Opps", main_app.admin_funding_opportunities_path, class: "sidebar-nav-link" %>
          <%= link_to "Todos", main_app.admin_todos_path, class: "sidebar-nav-link" %>
        <% end %>

      </nav>

      <%# User / sign out %>
      <% if current_user %>
        <div class="p-3 border-t border-white/10 flex-shrink-0">
          <div class="text-gray-400 text-sm font-medium truncate mb-0.5">
            <%= current_user.profile&.name || current_user.email_address.split("@").first %>
          </div>
          <div class="text-gray-600 text-xs truncate mb-2"><%= current_user.email_address %></div>
          <%= button_to "Sign Out", main_app.session_path, method: :delete,
              class: "text-xs text-gray-500 hover:text-white transition-colors" %>
        </div>
      <% end %>

    </aside>

    <%# Main content area %>
    <div class="flex-1 flex flex-col min-w-0 overflow-y-auto">

      <% if notice.present? %>
        <div class="mx-6 mt-4">
          <div class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 px-4 py-3 rounded-r-lg text-sm">
            <%= notice %>
          </div>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="mx-6 mt-4">
          <div class="bg-rose-50 border-l-4 border-rose-500 text-rose-800 px-4 py-3 rounded-r-lg text-sm">
            <%= alert %>
          </div>
        </div>
      <% end %>

      <main class="flex-1 py-6">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
          <%= yield %>
        </div>
      </main>

    </div>

  </body>
</html>
