<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Meitheal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Meitheal">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <nav class="bg-white shadow">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex justify-between h-16">
          <div class="flex items-center space-x-8">
            <%= link_to "NCF", root_path, class: "text-xl font-bold text-pink-600" %>
            <%= link_to "Events", events_path, class: "text-gray-700 hover:text-pink-600" %>
            <%= link_to "Calendar", calendar_path, class: "text-gray-700 hover:text-pink-600" %>
            <%= link_to "Members", profiles_path, class: "text-gray-700 hover:text-pink-600" %>
            <%= link_to "Funding", funding_opportunities_path, class: "text-gray-700 hover:text-pink-600" %>
          </div>
          <div class="flex items-center space-x-4">
            <% if authenticated? %>
              <% if current_user_can_edit? %>
                <%= link_to "Newsletters", newsletters_path, class: "text-gray-600 hover:text-pink-600" %>
                <%= link_to "Pages", admin_pages_path, class: "text-gray-600 hover:text-pink-600" %>
              <% end %>
              <% if current_user_can_manage? %>
                <%= link_to "Users", admin_users_path, class: "text-gray-600 hover:text-pink-600" %>
                <%= link_to "Memberships", admin_memberships_path, class: "text-gray-600 hover:text-pink-600" %>
                <%= link_to "Proposals", admin_proposals_path, class: "text-gray-600 hover:text-pink-600" %>
                <%= link_to "Email Groups", admin_email_groups_path, class: "text-gray-600 hover:text-pink-600" %>
              <% end %>
              <%= link_to "My Profile", my_profile_path, class: "text-gray-600 hover:text-pink-600" %>
              <%= button_to "Sign Out", session_path, method: :delete, class: "text-gray-600 hover:text-pink-600" %>
            <% else %>
              <%= link_to "Sign In", new_session_path, class: "text-pink-600 hover:text-pink-800" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="max-w-6xl mx-auto px-4 mt-4">
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="max-w-6xl mx-auto px-4 mt-4">
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <main class="py-8">
      <%= yield %>
    </main>
  </body>
</html>
