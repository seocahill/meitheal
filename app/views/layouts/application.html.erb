<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "THENCF" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="THENCF">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload", preload: false %>
    <%= stylesheet_link_tag "theme", "data-turbo-track": "reload", preload: false %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload", preload: false %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <nav class="nav-gradient">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex justify-between h-14">
          <div class="flex items-center gap-6">
            <%= link_to root_path, class: "text-xl font-bold text-white hover:text-white/90" do %>
              THENCF
            <% end %>
            <div class="hidden md:flex items-center gap-4">
              <%= link_to "News", posts_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
              <%= link_to "Events", events_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
              <%= link_to "Gallery", artists_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
              <%= link_to "Members", profiles_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
              <%= link_to "Forum", thredded_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
              <%= link_to "Funding", funding_opportunities_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
              <%= link_to "Calendar", calendar_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <% if authenticated? %>
              <% if current_user_can_edit? %>
                <div class="hidden lg:flex items-center gap-3">
                  <%= link_to "Newsletters", newsletters_path, class: "text-white/80 hover:text-white text-sm" %>
                  <%= link_to "Pages", admin_pages_path, class: "text-white/80 hover:text-white text-sm" %>
                </div>
              <% end %>
              <% if current_user_can_manage? %>
                <div class="relative" data-controller="dropdown">
                  <button data-action="click->dropdown#toggle" class="text-white/80 hover:text-white text-sm font-medium">
                    Admin ▾
                  </button>
                  <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg py-2 z-50">
                    <%= link_to "Inbox", admin_inbox_index_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 text-sm" %>
                    <%= link_to "Todos", admin_todos_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 text-sm" %>
                    <%= link_to "Users", admin_users_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 text-sm" %>
                    <%= link_to "Memberships", admin_memberships_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 text-sm" %>
                    <%= link_to "Proposals", admin_proposals_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 text-sm" %>
                    <%= link_to "Email Groups", admin_email_groups_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 text-sm" %>
                  </div>
                </div>
              <% end %>
              <%= link_to "Account", my_profile_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
              <%= button_to "Sign Out", session_path, method: :delete, class: "text-white/70 hover:text-white text-sm" %>
            <% else %>
              <%= link_to "Sign In", new_session_path, class: "text-white font-medium text-sm px-3 py-1 bg-white/20 rounded-lg hover:bg-white/30" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-4">
        <div class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 px-4 py-3 rounded-r-lg">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-4">
        <div class="bg-rose-50 border-l-4 border-rose-500 text-rose-800 px-4 py-3 rounded-r-lg">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <main class="py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-gray-200 mt-16 py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <p class="text-gray-500 text-sm">
            THENCF &middot; North Connacht Cultural Co-op &middot; Ballina, Co. Mayo
          </p>
          <div class="flex gap-4 text-sm">
            <%= link_to "About", page_path("about"), class: "text-gray-500 hover:text-purple-600" %>
            <%= link_to "Contact", page_path("contact"), class: "text-gray-500 hover:text-purple-600" %>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
