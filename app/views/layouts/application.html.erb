<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "THENCF" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="THENCF">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload", preload: false %>
    <%= stylesheet_link_tag "theme", "data-turbo-track": "reload", preload: false %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload", preload: false %>
    <%= javascript_importmap_tags %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <% if authenticated? %>

    <%# ============================================================ %>
    <%# Authenticated layout: sidebar + content area %>
    <%# ============================================================ %>
    <body class="bg-gray-50 h-screen flex overflow-hidden" data-controller="mobile-menu">

      <aside class="hidden md:flex w-56 flex-shrink-0 flex-col bg-gray-900 overflow-y-auto absolute inset-y-0 left-0 z-50 md:relative" data-mobile-menu-target="menu">

        <%# Brand %>
        <div class="h-14 flex items-center px-4 flex-shrink-0 nav-gradient">
          <%= link_to root_path, class: "text-white font-bold text-lg leading-none" do %>
            THENCF
          <% end %>
        </div>

        <%# Navigation %>
        <nav class="flex-1 p-2 space-y-0.5">

          <%= link_to t("dashboard"), dashboard_path, class: sidebar_nav_class("dashboard") %>
          <%= link_to t("forum"), thredded_path,
              class: "sidebar-nav-link #{request.path.start_with?("/forum") ? "sidebar-nav-active" : ""}" %>

          <div class="sidebar-nav-section"><%= t("explore") %></div>
          <%= link_to t("news"), posts_path, class: sidebar_nav_class("posts") %>
          <%= link_to t("events"), events_path, class: sidebar_nav_class("events") %>
          <%= link_to t("gallery"), artists_path, class: sidebar_nav_class("artists") %>
          <%= link_to t("projects"), projects_path, class: sidebar_nav_class("projects") %>
          <%= link_to t("members"), profiles_path, class: sidebar_nav_class("profiles") %>

          <div class="sidebar-nav-section"><%= t("participate") %></div>
          <%= link_to t("funding"), funding_opportunities_path, class: sidebar_nav_class("funding_opportunities") %>
          <%= link_to t("book_space"), calendar_path, class: sidebar_nav_class("bookings") %>
          <%= link_to t("make_payment"), new_payment_path, class: sidebar_nav_class("payments") %>

          <% if current_user_can_edit? %>
            <div class="sidebar-nav-section"><%= t("manage") %></div>
            <%= link_to t("newsletters"), newsletters_path, class: sidebar_nav_class("newsletters") %>
            <%= link_to t("pages"), admin_pages_path, class: sidebar_nav_class("admin/pages") %>
            <%= link_to t("faqs"), admin_faqs_path, class: sidebar_nav_class("admin/faqs") %>
          <% end %>

          <% if current_user_can_manage? %>
            <div class="sidebar-nav-section"><%= t("admin") %></div>
            <%= link_to t("inbox"), admin_inbox_index_path, class: sidebar_nav_class("admin/inbox") %>
            <%= link_to t("email_groups"), admin_email_groups_path, class: sidebar_nav_class("admin/email_groups") %>
            <%= link_to t("users"), admin_users_path, class: sidebar_nav_class("admin/users") %>
            <%= link_to t("memberships"), admin_memberships_path, class: sidebar_nav_class("admin/memberships") %>
            <%= link_to t("payments"), admin_payments_path, class: sidebar_nav_class("admin/payments") %>
            <%= link_to t("transactions"), admin_transactions_path, class: sidebar_nav_class("admin/transactions") %>
            <%= link_to t("bookings"), admin_bookings_path, class: sidebar_nav_class("admin/bookings") %>
            <%= link_to t("ticket_sales"), admin_ticket_sales_path, class: sidebar_nav_class("admin/ticket_sales") %>
            <%= link_to t("proposals"), admin_proposals_path, class: sidebar_nav_class("admin/proposals") %>
            <%= link_to t("funding_opps"), admin_funding_opportunities_path, class: sidebar_nav_class("admin/funding_opportunities") %>
            <%= link_to t("todos"), admin_todos_path, class: sidebar_nav_class("admin/todos") %>
          <% end %>

        </nav>

        <%# User / sign out %>
        <div class="p-3 border-t border-white/10 flex-shrink-0">
          <div class="text-gray-400 text-sm font-medium truncate mb-0.5">
            <%= Current.user.profile&.name || Current.user.email_address.split("@").first %>
          </div>
          <div class="text-gray-600 text-xs truncate mb-2"><%= Current.user.email_address %></div>
          <%= button_to t("sign_out"), session_path, method: :delete,
              class: "text-xs text-gray-500 hover:text-white transition-colors" %>
        </div>

      </aside>

      <%# Mobile backdrop %>
      <div class="hidden fixed inset-0 z-40 bg-black/50 md:hidden" data-mobile-menu-target="menu" data-action="click->mobile-menu#close"></div>

      <%# Main content area %>
      <div class="flex-1 flex flex-col min-w-0 overflow-y-auto">

        <%# Mobile top bar %>
        <div class="md:hidden flex items-center px-4 h-14 bg-gray-900 flex-shrink-0">
          <button data-action="mobile-menu#toggle" class="text-white p-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <span class="ml-3 text-white font-bold text-lg">THENCF</span>
        </div>

        <%# Flash messages %>
        <% if notice.present? %>
          <div class="mx-6 mt-4">
            <div class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 px-4 py-3 rounded-r-lg text-sm">
              <%= notice %>
            </div>
          </div>
        <% end %>

        <% if alert.present? %>
          <div class="mx-6 mt-4">
            <div class="bg-rose-50 border-l-4 border-rose-500 text-rose-800 px-4 py-3 rounded-r-lg text-sm">
              <%= alert %>
            </div>
          </div>
        <% end %>

        <main class="flex-1 py-8">
          <%= yield %>
        </main>

      </div>

    </body>

  <% else %>

    <%# ============================================================ %>
    <%# Public layout: horizontal nav %>
    <%# ============================================================ %>
    <body class="bg-gray-50 min-h-screen">

      <nav class="nav-gradient">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
          <div class="flex justify-between h-14">
            <div class="flex items-center gap-4">
              <%= link_to root_path, class: "text-xl font-bold text-white hover:text-white/90" do %>
                THENCF
              <% end %>
              <div class="hidden md:flex items-center gap-4">
                <%= link_to t("news"), posts_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
                <%= link_to t("events"), events_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
                <%= link_to t("gallery"), artists_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
                <%= link_to t("bookings"), calendar_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
                <%= link_to t("projects"), projects_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
                <%= link_to t("newsletter"), newsletter_page_path, class: "text-white/90 hover:text-white text-sm font-medium" %>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <%= link_to t("switch_language"), switch_locale_path_for_other_language, class: "text-white/80 hover:text-white text-sm font-medium" %>
              <%= link_to t("sign_in"), new_session_path, class: "text-white font-medium text-sm px-3 py-1.5 bg-white/20 rounded-lg hover:bg-white/30" %>
            </div>
          </div>
        </div>
      </nav>

      <% if notice.present? %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-4">
          <div class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-800 px-4 py-3 rounded-r-lg">
            <%= notice %>
          </div>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-4">
          <div class="bg-rose-50 border-l-4 border-rose-500 text-rose-800 px-4 py-3 rounded-r-lg">
            <%= alert %>
          </div>
        </div>
      <% end %>

      <main class="py-8">
        <%= yield %>
      </main>

      <footer class="border-t border-gray-200 mt-16 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
          <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-gray-500 text-sm">
              <%= t("org_tagline") %>
            </p>
            <div class="flex gap-4 text-sm">
              <%= link_to t("about"), page_path("about"), class: "text-gray-500 hover:text-purple-600" %>
              <%= link_to t("contact"), contact_path, class: "text-gray-500 hover:text-purple-600" %>
              <%= link_to t("newsletter"), newsletter_page_path, class: "text-gray-500 hover:text-purple-600" %>
              <%= link_to t("privacy"), page_path("privacy"), class: "text-gray-500 hover:text-purple-600" %>
            </div>
          </div>
        </div>
      </footer>

    </body>

  <% end %>
</html>
