<%= form_with model: booking, class: "space-y-6" do |form| %>
  <% if booking.errors.any? %>
    <div class="form-error">
      <h2><%= pluralize(booking.errors.count, "error") %> prohibited this booking from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% booking.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :space_id, "Space", class: "form-label" %>
    <%= form.collection_select :space_id, @spaces, :id, :name, { prompt: "Select a space" }, class: "form-input" %>
  </div>

  <div>
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-input" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :starts_at, "Start Time", class: "form-label" %>
      <%= form.datetime_local_field :starts_at, class: "form-input" %>
    </div>

    <div>
      <%= form.label :ends_at, "End Time", class: "form-label" %>
      <%= form.datetime_local_field :ends_at, class: "form-input" %>
    </div>
  </div>

  <div>
    <%= form.label :description, "Notes (optional)", class: "form-label" %>
    <%= form.text_area :description, rows: 3, class: "form-input" %>
  </div>

  <div class="flex items-center justify-end gap-4 pt-4 border-t border-gray-100">
    <%= link_to "Cancel", calendar_path, class: "text-gray-600 hover:text-gray-900" %>
    <%= form.submit class: "btn-primary text-white px-6 py-2.5 rounded-xl font-medium cursor-pointer" %>
  </div>
<% end %>
