<%= form_with model: booking, class: "space-y-6" do |form| %>
  <% if booking.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <h2 class="font-bold"><%= pluralize(booking.errors.count, "error") %> prohibited this booking from being saved:</h2>
      <ul class="list-disc list-inside mt-2">
        <% booking.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :space_id, "Space", class: "block text-sm font-medium text-gray-700" %>
    <%= form.collection_select :space_id, @spaces, :id, :name, { prompt: "Select a space" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :starts_at, "Start Time", class: "block text-sm font-medium text-gray-700" %>
      <%= form.datetime_local_field :starts_at, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
    </div>

    <div>
      <%= form.label :ends_at, "End Time", class: "block text-sm font-medium text-gray-700" %>
      <%= form.datetime_local_field :ends_at, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
    </div>
  </div>

  <div>
    <%= form.label :description, "Notes (optional)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500" %>
  </div>

  <div class="flex items-center justify-end gap-4">
    <%= link_to "Cancel", calendar_path, class: "text-gray-600 hover:text-gray-800" %>
    <%= form.submit class: "bg-pink-600 text-white px-6 py-2 rounded hover:bg-pink-700 cursor-pointer" %>
  </div>
<% end %>
