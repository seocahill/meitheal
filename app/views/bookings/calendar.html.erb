<div class="max-w-6xl mx-auto px-4 py-8">
  <% if !authenticated? %>
    <div class="mb-6 bg-amber-50 border border-amber-300 rounded-lg p-4 flex flex-col sm:flex-row sm:items-start gap-3">
      <svg class="w-6 h-6 text-amber-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
      <div>
        <p class="font-semibold text-amber-800">You must be logged in to book.</p>
        <p class="text-sm text-amber-700 mt-1">
          Please read the <a href="https://thencf.art/booking-rules" target="_blank" class="underline hover:text-amber-900">booking rules</a> before booking.
          If you have any questions please <a class="underline hover:text-amber-900" href="https://thencf.art/contact">contact us</a>.
        </p>
      </div>
    </div>
  <% elsif !Current.user.has_active_membership? %>
    <div class="mb-6 bg-red-50 border border-red-300 rounded-lg p-4 flex flex-col sm:flex-row sm:items-start gap-3">
      <svg class="w-6 h-6 text-red-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
      <div>
        <p class="font-semibold text-red-800">You must pay your annual subscription to book.</p>
        <p class="text-sm text-red-700 mt-1">
          Please read the <a href="https://thencf.art/booking-rules" target="_blank" class="underline hover:text-red-900">booking rules</a> before booking.
          If you have any questions please <a class="underline hover:text-red-900" href="https://thencf.art/contact">contact us</a>.
        </p>
      </div>
    </div>
  <% end %>

  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Space Calendar</h1>
    <% if authenticated? %>
      <div class="flex items-center gap-3">
        <% if current_user_can_manage? %>
          <%= link_to "Import calendar", new_admin_calendar_import_path, class: "bg-gray-100 text-gray-800 px-4 py-2 rounded hover:bg-gray-200 text-sm" %>
        <% end %>
        <% if Current.user.has_active_membership? %>
          <%= link_to "Book Space", new_booking_path, class: "bg-pink-600 text-white px-4 py-2 rounded hover:bg-pink-700" %>
        <% else %>
          <span class="text-sm text-gray-500">Active membership required to book</span>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Admin: Pending Bookings Needing Approval -->
  <% if authenticated? && current_user_can_manage? %>
    <% if @pending_bookings&.any? %>
      <div class="mb-8 bg-amber-50 border border-amber-200 rounded-lg p-4">
        <h2 class="text-lg font-semibold text-amber-800 mb-3">Pending Bookings Needing Approval</h2>
        <div class="space-y-2">
          <% @pending_bookings.each do |booking| %>
            <div class="flex justify-between items-center bg-white rounded p-3 border border-amber-200">
              <div>
                <span class="font-medium"><%= booking.title %></span>
                <span class="text-sm text-gray-500 ml-2">
                  <%= booking.starts_at.strftime("%b %d, %l:%M %p") %> - <%= booking.space.name %>
                </span>
                <span class="text-sm text-gray-400 ml-2">by <%= booking.user.name %></span>
              </div>
              <div class="flex gap-2">
                <%= button_to "Confirm", confirm_booking_path(booking), method: :patch, class: "px-3 py-1 bg-green-600 text-white text-sm rounded hover:bg-green-700" %>
                <%= button_to "Decline", cancel_booking_path(booking), method: :patch, data: { turbo_confirm: "Decline this booking?" }, class: "px-3 py-1 bg-red-600 text-white text-sm rounded hover:bg-red-700" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <!-- Month Navigation -->
  <div class="flex justify-between items-center mb-6">
    <%= link_to "← Previous", calendar_path(month: (@month - 1.month).strftime("%Y-%m")), class: "text-pink-600 hover:text-pink-800" %>
    <h2 class="text-2xl font-semibold"><%= @month.strftime("%B %Y") %></h2>
    <%= link_to "Next →", calendar_path(month: (@month + 1.month).strftime("%Y-%m")), class: "text-pink-600 hover:text-pink-800" %>
  </div>

  <!-- Legend -->
  <div class="flex gap-4 mb-4 text-sm">
    <div class="flex items-center gap-2">
      <span class="w-4 h-4 rounded bg-green-100 border border-green-300"></span>
      <span class="text-gray-600">Confirmed</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-4 h-4 rounded bg-amber-100 border border-amber-300"></span>
      <span class="text-gray-600">Pending</span>
    </div>
  </div>

  <!-- Calendar Grid -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <!-- Day headers -->
    <div class="grid grid-cols-7 bg-gray-50 border-b">
      <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day| %>
        <div class="p-2 text-center text-sm font-medium text-gray-500"><%= day %></div>
      <% end %>
    </div>

    <!-- Calendar days -->
    <div class="grid grid-cols-7">
      <% start_date = @month.beginning_of_month.beginning_of_week(:sunday) %>
      <% end_date = @month.end_of_month.end_of_week(:sunday) %>

      <% (start_date..end_date).each do |date| %>
        <% day_bookings = @bookings.select { |b| b.starts_at.to_date <= date && b.ends_at.to_date >= date } %>
        <div class="min-h-[100px] border-b border-r p-2 <%= 'bg-gray-50' unless date.month == @month.month %>">
          <div class="text-sm <%= date == Date.current ? 'bg-pink-600 text-white rounded-full w-6 h-6 flex items-center justify-center' : 'text-gray-500' %>">
            <%= date.day %>
          </div>
          <div class="mt-1 space-y-1">
            <% day_bookings.each do |booking| %>
              <% color_class = booking.confirmed? ? 'bg-green-100 text-green-800 border-green-200' : 'bg-amber-100 text-amber-800 border-amber-200' %>
              <% is_start = booking.starts_at.to_date == date %>
              <div class="text-xs p-1 rounded border <%= color_class %> truncate" title="<%= booking.title %> - <%= booking.space.name %><%= ' (pending)' if booking.pending? %>">
                <% if is_start %>
                  <span class="font-medium"><%= booking.starts_at.strftime("%H:%M") %></span>
                <% else %>
                  <span class="font-medium">→</span>
                <% end %>
                <%= booking.title %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Upcoming Bookings List -->
  <% if authenticated? && current_user_can_edit? %>
    <div class="mt-8">
      <h2 class="text-2xl font-bold mb-4">Upcoming Bookings</h2>
      <% upcoming = @bookings.select { |b| b.starts_at > Time.current && b.confirmed? }.first(5) %>
      <% if upcoming.empty? %>
        <p class="text-gray-600">No upcoming confirmed bookings this month.</p>
      <% else %>
        <div class="space-y-4">
          <% upcoming.each do |booking| %>
            <div class="bg-white rounded-lg shadow p-4 flex justify-between items-center">
              <div>
                <h3 class="font-semibold">
                  <%= booking.title %>
                  <% if booking.paid %>
                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Paid</span>
                  <% else %>
                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800">Unpaid</span>
                  <% end %>
                </h3>
                <p class="text-sm text-gray-600">
                  <%= booking.starts_at.strftime("%A, %B %d at %l:%M %p") %> - <%= booking.ends_at.strftime("%l:%M %p") %>
                </p>
                <p class="text-sm text-gray-500"><%= booking.space.name %></p>
              </div>
              <% if current_user_can_edit? %>
                <div class="flex gap-2">
                  <% unless booking.paid %>
                    <%= button_to "Mark as Paid", mark_as_paid_booking_path(booking), method: :patch, class: "text-green-600 hover:text-green-800" %>
                  <% end %>
                  <%= link_to "Edit", edit_booking_path(booking), class: "text-gray-600 hover:text-gray-800" %>
                  <%= button_to "Cancel", cancel_booking_path(booking), method: :patch, data: { turbo_confirm: "Cancel this booking?" }, class: "text-red-600 hover:text-red-800" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <!-- Spaces List -->
  <% if @spaces.any? %>
    <div class="mt-8">
      <h2 class="text-2xl font-bold mb-4">Available Spaces</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @spaces.each do |space| %>
          <div class="bg-white rounded-lg shadow p-4">
            <h3 class="font-semibold"><%= space.name %></h3>
            <% if space.capacity.present? %>
              <p class="text-sm text-gray-500">Capacity: <%= space.capacity %></p>
            <% end %>
            <% if space.description.present? %>
              <p class="text-sm text-gray-600 mt-2"><%= space.description %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
