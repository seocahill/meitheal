<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Booking</h1>

  <%= render "form", booking: @booking %>

  <% if @booking.pending? && current_user_can_edit? %>
    <div class="mt-6 pt-6 border-t border-gray-200">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Booking Actions</h2>
      <div class="flex gap-4">
        <%= button_to "Confirm Booking", confirm_booking_path(@booking), method: :patch, class: "bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
      </div>
    </div>
  <% end %>

  <% if @booking.confirmed? %>
    <div class="mt-6 pt-6 border-t border-gray-200">
      <%= button_to "Cancel Booking", cancel_booking_path(@booking), method: :patch, class: "bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700", data: { turbo_confirm: "Are you sure you want to cancel this booking?" } %>
    </div>
  <% end %>
</div>
