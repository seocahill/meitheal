---
blog: faq
pageable: false
---
<div class="mx-auto max-w-7xl py-12 px-4 sm:px-6 lg:flex lg:items-center lg:justify-between lg:py-16 lg:px-8">
  <div class="prose lg:prose-xl">
    <h2>Frequently Asked Questions</h2>
    <% blog('faq').articles.sort_by { |a| a.data.order || 999 }.each do |article| %>
      <details class="mb-4 border-b pb-4">
        <summary class="cursor-pointer font-semibold text-xl hover:text-blue-600"><%= article.title %></summary>
        <div class="mt-4">
          <%= article.body %>
        </div>
      </details>
    <% end %>
  </div>
</div>
