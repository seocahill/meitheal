---
title: Booking our Space
---

<div class="container mx-auto px-4 py-8">
  <h1 class="text-4xl font-bold mb-6">Space</h1>

  <!-- Step-by-Step Instructions -->
  <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
    <h2 class="text-2xl font-semibold mb-4">How to Book Our Space</h2>
    <ol class="space-y-6">
      <li class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-indigo-600 text-white rounded-full flex items-center justify-center font-bold">1</span>
        <div>
          <h3 class="font-semibold text-lg">Check Out the Space</h3>
          <p class="text-gray-600 mb-2">Take a look at our space and facilities to make sure it meets your needs.</p>
          <a href="projects/community-night-space.html" class="text-blue-600 hover:text-blue-800 hover:underline inline-flex items-center">
            Pictures of the Space
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </li>

      <li class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-indigo-600 text-white rounded-full flex items-center justify-center font-bold">2</span>
        <div>
          <h3 class="font-semibold text-lg">Understand the Terms</h3>
          <p class="text-gray-600 mb-2">Please note that a minimum of 20 euros is required to cover shared costs per day. All bookings are provisional until confirmed by email. Space is for members use only.</p>
          <a href="#terms" class="text-blue-600 hover:text-blue-800 hover:underline inline-flex items-center">
            Read Full Terms
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
        </div>
      </li>

      <li class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-indigo-600 text-white rounded-full flex items-center justify-center font-bold">3</span>
        <div>
          <h3 class="font-semibold text-lg">Check Availability</h3>
          <p class="text-gray-600 mb-2">View our calendar to find available dates and times.</p>
          <a href="#calendar" class="text-blue-600 hover:text-blue-800 hover:underline inline-flex items-center">
            View Calendar
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
        </div>
      </li>

      <li class="flex gap-4">
        <span class="flex-shrink-0 w-8 h-8 bg-indigo-600 text-white rounded-full flex items-center justify-center font-bold">4</span>
        <div>
          <h3 class="font-semibold text-lg">Make Your Booking</h3>
          <p class="text-gray-600 mb-2">Fill out the booking form with your details and requirements.</p>
          <a href="#booking-form" class="text-blue-600 hover:text-blue-800 hover:underline inline-flex items-center">
            Go to Booking Form
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
        </div>
      </li>
    </ol>
  </div>

  <!-- Terms Section -->
  <div id="terms" class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Terms and Conditions</h2>
    <div class="bg-white rounded-lg shadow-lg p-6">
      <ul class="list-disc list-inside space-y-3 text-gray-600">
        <li>Minimum booking fee: €20 per day to cover shared costs</li>
        <li>All bookings are provisional until confirmed by email</li>
        <li>Space is for members use only</li>
        <li>Please ensure you leave the space as you found it</li>
        <li>Bookings are subject to availability</li>
      </ul>
    </div>
  </div>

  <!-- Calendar Section -->
  <div id="calendar" class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Space Availability</h2>
    <div class="flex gap-2 mb-4">
      <button onclick="changeView('day')" class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" id="day-btn">Day</button>
      <button onclick="changeView('week')" class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" id="week-btn">Week</button>
      <button onclick="changeView('month')" class="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700" id="month-btn">Month</button>
    </div>
    <div class="h-[800px] bg-white rounded-lg shadow-lg overflow-hidden" id="calendar-container">
      <iframe
        id="calendar-frame"
        src="https://calendar.zoho.eu/zc/ui/embed/#calendar=zz080112305d7a91c2799a3968f9c565a3cab5dbae263f2623450dc212a90ab6b72d6cd5a55a935dd9f429017819e42aa1fff26aa2&title=Co-op%20Space&type=1&language=en&timezone=Europe%2FDublin&showTitle=1&showTimezone=1&view=month&showDetail=0&theme=1&eventColorType=light&showLogo=1"
        frameborder="0"
        class="w-full h-full"
        scrolling="no"
      ></iframe>
    </div>
  </div>

  <script>
    function changeView(viewType) {
      const frame = document.getElementById('calendar-frame');
      const currentSrc = frame.src;
      const newSrc = currentSrc.replace(/view=[^&]+/, `view=${viewType}`);
      frame.src = newSrc;
      
      // Update button styles
      document.getElementById('day-btn').className = 'px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300';
      document.getElementById('week-btn').className = 'px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300';
      document.getElementById('month-btn').className = 'px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300';
      
      // Set active button style
      document.getElementById(`${viewType}-btn`).className = 'px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700';
    }
  </script>

  <!-- Booking Form Section -->
  <div id="booking-form" class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Booking Form</h2>
    <p class="text-sm text-gray-500 mb-4">All fields are required</p>
    <form
      name="space-booking"
      method="POST"
      data-netlify="true"
      class="space-y-6 bg-white p-6 rounded-lg shadow-lg"
    >
      <input type="hidden" name="booking-form" value="booking" />

      <!-- Name Field -->
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700">Name <span class="text-red-500">*</span></label>
        <input
          type="text"
          name="name"
          id="name"
          required
          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
        >
      </div>

      <!-- Email Field -->
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">Email <span class="text-red-500">*</span></label>
        <input
          type="email"
          name="email"
          id="email"
          required
          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
        >
      </div>

      <!-- Date Field -->
      <div>
        <label for="date" class="block text-sm font-medium text-gray-700">Date <span class="text-red-500">*</span></label>
        <input
          type="date"
          name="date"
          id="date"
          required
          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
        >
      </div>

      <!-- Room Selection -->
      <div>
        <label for="room" class="block text-sm font-medium text-gray-700">Room <span class="text-red-500">*</span></label>
        <select
          name="room"
          id="room"
          required
          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
        >
          <option value="">Select a room</option>
          <option value="back">Back Room</option>
          <option value="front">Front Room</option>
          <option value="small">Small Room</option>
          <option value="all">All Rooms</option>
        </select>
      </div>

      <!-- Message Field -->
      <div>
        <label for="description" class="block text-sm font-medium text-gray-700">Description <span class="text-red-500">*</span></label>
        <textarea required name="description" id="description" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" placeholder="Tell us what you're planning to use the space for."></textarea>
      </div>

      <!-- Booking Rules Checkbox -->
      <div class="flex items-start">
        <div class="flex items-center h-5">
          <input
            id="booking-rules"
            name="booking-rules"
            type="checkbox"
            required
            class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded"
          >
        </div>
        <div class="ml-3 text-sm">
          <label for="booking-rules" class="font-medium text-gray-700">
            I have read and understand the <a href="/faq.html#booking-rules" class="text-blue-600 hover:underline" target="_blank">booking rules</a> <span class="text-red-500">*</span>
          </label>
        </div>
      </div>

      <!-- Code of Ethics Checkbox -->
      <div class="flex items-start">
        <div class="flex items-center h-5">
          <input
            id="code-of-ethics"
            name="code-of-ethics"
            type="checkbox"
            required
            class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded"
          >
        </div>
        <div class="ml-3 text-sm">
          <label for="code-of-ethics" class="font-medium text-gray-700">
            My event complies with the <a href="/files/ncf-ethics.pdf" class="text-blue-600 hover:underline" target="_blank">code of ethics</a> <span class="text-red-500">*</span>
          </label>
        </div>
      </div>

      <!-- Membership Contribution Checkbox -->
      <div class="flex items-start">
        <div class="flex items-center h-5">
          <input
            id="membership-contribution"
            name="membership-contribution"
            type="checkbox"
            required
            class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded"
          >
        </div>
        <div class="ml-3 text-sm">
          <label for="membership-contribution" class="font-medium text-gray-700">
            I have paid my <a href="/members.html" class="text-blue-600 hover:underline" target="_blank">membership contribution</a> <span class="text-red-500">*</span>
          </label>
        </div>
      </div>

      <!-- Submit Button -->
      <div>
        <button
          type="submit"
          class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
        >
          Submit Booking
        </button>
      </div>
    </form>
  </div>
</div>